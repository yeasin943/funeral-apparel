{% doc %}
  Search palette results styles, shared by the search modal and the predictive-search and
  predictive-search-empty sections. Desktop follows Figma "Search B"; mobile follows
  "Search v1". Palette color tokens are defined on `.search-modal` in search-modal.liquid.

  @example
  {% render 'predictive-search-styles' %}
{% enddoc %}

{% stylesheet %}
  .predictive-search-dropdown {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
  }

  .predictive-search-results__inner {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    color: var(--search-palette-ink);
    scrollbar-width: thin;
  }

  /* Toolbar: scope pills + View all (desktop only) */
  .search-palette__toolbar {
    position: sticky;
    top: 0;
    z-index: var(--layer-raised);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 24px;
    border-block-end: 1px solid var(--search-palette-line);
    background-color: var(--color-background);

    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .search-palette__scopes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    min-width: 0;
  }

  .search-palette__scope {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border: 1px solid var(--search-palette-line);
    font-family: var(--font-subheading--family);
    font-style: var(--font-subheading--style);
    font-weight: var(--font-subheading--weight);
    font-size: 0.75rem;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--search-palette-ink);
    cursor: pointer;
    transition: border-color var(--animation-speed) var(--animation-easing);

    &:hover {
      border-color: var(--search-palette-ink);
    }

    &[aria-pressed='true'] {
      border-color: var(--search-palette-ink);
      background-color: var(--search-palette-ink);
      color: var(--color-background);
    }
  }

  .search-palette__scope-count {
    color: var(--search-palette-muted);

    [aria-pressed='true'] > & {
      color: var(--search-palette-ash);
    }
  }

  /* "View all" and "Clear" */
  .search-palette__text-link {
    flex-shrink: 0;
    padding: 0 0 3px;
    border: 0;
    border-block-end: 1.5px solid var(--search-palette-ink);
    border-radius: 0;
    background: none;
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style);
    font-weight: var(--font-accent--weight);
    font-size: 0.875rem;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--search-palette-ink);
    cursor: pointer;

    &:hover {
      color: var(--search-palette-ink);
      opacity: var(--opacity-subdued-text);
    }
  }

  /* Result groups */
  .search-palette__results,
  .predictive-search-results__products {
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding: 16px 24px 24px;

    @media screen and (max-width: 749px) {
      gap: 28px;
      padding: 16px 8px 12px;
    }
  }

  .search-palette__group {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    animation: search-element-slide-up var(--animation-speed-medium) var(--animation-timing-bounce) backwards;
  }

  .search-palette__label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 24px;

    @media screen and (max-width: 749px) {
      min-height: 0;
      padding-inline: 8px;
    }
  }

  .search-palette__label {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-style: var(--font-subheading--style);
    font-weight: var(--font-subheading--weight);
    font-size: 0.75rem;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--search-palette-ink);

    @media screen and (max-width: 749px) {
      color: var(--search-palette-muted);
    }
  }

  .search-palette__chevron {
    display: flex;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    color: var(--search-palette-ash);

    svg {
      width: 100%;
      height: 100%;
    }
  }

  /* Products: 4-up cards on desktop, thumbnail rows on mobile */
  .search-palette__products {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 0;

    @media screen and (max-width: 749px) {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
  }

  .search-palette-product {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    color: var(--search-palette-ink);
    text-decoration: none;

    &:hover {
      color: var(--search-palette-ink);
    }

    @media screen and (max-width: 749px) {
      flex-direction: row;
      align-items: center;
      gap: 14px;
      padding: 8px;
    }
  }

  .search-palette-product__media {
    position: relative;
    display: block;
    aspect-ratio: 149 / 176;
    overflow: hidden;
    background-color: var(--search-palette-media);

    /* 1.5px ink frame for hover and keyboard focus */
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      border: 1.5px solid var(--search-palette-ink);
      opacity: 0;
    }

    @media screen and (max-width: 749px) {
      flex: 0 0 48px;
      width: 48px;
      height: 60px;
      aspect-ratio: auto;

      &::after {
        content: none;
      }
    }
  }

  .search-palette-product__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .search-palette-product__info {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;

    @media screen and (max-width: 749px) {
      flex: 1 1 auto;
      gap: 4px;
    }
  }

  .search-palette-product__title {
    font-family: var(--font-subheading--family);
    font-style: var(--font-subheading--style);
    font-weight: var(--font-subheading--weight);
    font-size: 0.875rem;
    line-height: 1.45;
    overflow-wrap: anywhere;

    @media screen and (max-width: 749px) {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  .search-palette-product__price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 6px;
    font-family: var(--font-subheading--family);
    font-style: var(--font-subheading--style);
    font-weight: var(--font-subheading--weight);
    font-size: 0.875rem;
    line-height: 1.45;
    white-space: nowrap;

    @media screen and (max-width: 749px) {
      column-gap: 8px;
    }
  }

  .search-palette-product__price-sale {
    color: var(--search-palette-sale);
  }

  .search-palette-product__price-compare {
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-weight: var(--font-body--weight);
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--search-palette-muted);
    text-decoration-skip-ink: none;
  }

  .search-palette-product .search-palette__chevron {
    display: none;

    @media screen and (max-width: 749px) {
      display: flex;
    }
  }

  /* Collections: 2-up image cards on desktop, thumbnail rows on mobile */
  .search-palette__collections {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;

    @media screen and (max-width: 749px) {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
  }

  .search-palette-resource {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
    color: var(--search-palette-ink);
    text-decoration: none;

    &:hover {
      color: var(--search-palette-ink);
    }
  }

  .search-palette-resource__title {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-palette-resource--collection {
    position: relative;
    aspect-ratio: 310 / 148;
    overflow: hidden;
    background-image: linear-gradient(154deg, rgb(158 153 145) 0%, rgb(92 87 82) 71%);
    color: var(--color-background);

    &:hover {
      color: var(--color-background);
    }

    /* Bottom gradient keeps the label at 4.5:1 or better */
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: linear-gradient(to bottom, rgb(11 11 11 / 0) 30%, rgb(11 11 11 / 0.75));
    }

    .search-palette-resource__media {
      position: absolute;
      inset: 0;
    }

    .search-palette-resource__title,
    .search-palette__chevron {
      position: absolute;
      z-index: 1;
      inset-block-end: 14px;
      color: var(--color-background);
    }

    .search-palette-resource__title {
      inset-inline: 16px 48px;
      font-family: var(--font-accent--family);
      font-style: var(--font-accent--style);
      font-weight: var(--font-accent--weight);
      font-size: 1rem;
      line-height: 1.2;
    }

    .search-palette__chevron {
      inset-inline-end: 16px;
    }

    @media screen and (max-width: 749px) {
      aspect-ratio: auto;
      padding: 8px;
      background-image: none;
      color: var(--search-palette-ink);

      &::after {
        content: none;
      }

      .search-palette-resource__media {
        position: relative;
        flex: 0 0 48px;
        width: 48px;
        height: 60px;
        overflow: hidden;
        background-color: var(--search-palette-media);
      }

      .search-palette-resource__title,
      .search-palette__chevron {
        position: static;
        color: inherit;
      }

      .search-palette-resource__title {
        font-family: var(--font-subheading--family);
        font-style: var(--font-subheading--style);
        font-weight: var(--font-subheading--weight);
        font-size: 0.875rem;
        line-height: 1.45;
      }

      .search-palette__chevron {
        color: var(--search-palette-ash);
      }
    }
  }

  .search-palette-resource__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Pages and articles: text rows */
  .search-palette__rows {
    display: flex;
    flex-direction: column;
    margin: 0;

    @media screen and (max-width: 749px) {
      gap: 2px;
    }
  }

  .search-palette-resource--page,
  .search-palette-resource--article {
    gap: 16px;
    min-height: 40px;
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-weight: var(--font-body--weight);
    font-size: 1rem;
    line-height: 1.5;

    @media screen and (max-width: 749px) {
      gap: 14px;
      min-height: 44px;
      padding: 0 8px;
    }
  }

  /* Hover and keyboard focus */
  .search-palette__item:is(:hover, :focus-within, [aria-selected='true'].keyboard-focus) {
    .search-palette-product__media::after {
      opacity: 1;
    }

    .search-palette-resource--collection {
      outline: 1.5px solid var(--search-palette-ink);
      outline-offset: 0;
    }

    .search-palette__chevron {
      color: var(--search-palette-ink);
    }

    @media screen and (max-width: 749px) {
      .search-palette-product,
      .search-palette-resource {
        background-color: var(--search-palette-bone);
      }

      .search-palette-resource--collection {
        outline: none;
      }
    }
  }

  .search-palette__item a:focus-visible {
    outline: 1.5px solid var(--search-palette-ink);
    outline-offset: 0;
  }

  /* Suggestion chips (mobile only) */
  .search-palette__queries {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding-inline: 8px;
  }

  /* Block, not flex: a flex container would trim the space at the start of Shopify's <mark> */
  .search-palette__query {
    display: block;
    padding: 9px 12px;
    border: 1px solid var(--search-palette-line);
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style);
    font-weight: var(--font-accent--weight);
    font-size: 0.875rem;
    line-height: 1.45;
    white-space: nowrap;
    color: var(--search-palette-ink);
    text-decoration: none;

    /* Shopify marks the suggested completion; the typed part stays bold */
    mark {
      background: none;
      font-family: var(--font-body--family);
      font-style: var(--font-body--style);
      font-weight: var(--font-body--weight);
      color: inherit;
    }

    &:hover,
    .predictive-search-results__card--query[aria-selected='true'].keyboard-focus > & {
      border-color: var(--search-palette-ink);
      color: var(--search-palette-ink);
    }
  }

  /* Mobile "View all N results" bar */
  .search-palette__view-all-bar {
    position: sticky;
    bottom: 0;
    z-index: var(--layer-raised);
    display: none;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    padding-inline: 16px;
    background-color: var(--search-palette-ink);
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style);
    font-weight: var(--font-accent--weight);
    font-size: 0.875rem;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-background);
    text-decoration: none;

    &:hover {
      color: var(--color-background);
    }

    .search-palette__chevron {
      color: inherit;
    }

    @media screen and (max-width: 749px) {
      display: flex;
    }
  }

  .predictive-search-results__no-results {
    margin: 0;
    padding: 24px;
    font-size: 0.875rem;
    line-height: 1.45;
    text-align: center;
    color: var(--search-palette-muted);
  }

  /* Result limits: desktop "All" shows 4 products / 2 collections, a scope pill shows all of
     its type; mobile shows 3 product rows and 2 collection rows. */
  @media screen and (min-width: 750px) {
    .search-palette__group--queries,
    .search-palette__count {
      display: none;
    }

    [data-scope='all'] .search-palette__products > :nth-child(n + 5),
    [data-scope='all'] .search-palette__collections > :nth-child(n + 3),
    [data-scope='products'] [data-scope-group]:not([data-scope-group='products']),
    [data-scope='collections'] [data-scope-group]:not([data-scope-group='collections']),
    [data-scope='pages'] [data-scope-group]:not([data-scope-group='pages']),
    [data-scope='articles'] [data-scope-group]:not([data-scope-group='articles']) {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .search-palette__products > :nth-child(n + 4),
    .search-palette__collections > :nth-child(n + 3) {
      display: none;
    }
  }

  /* Recently viewed: collapse when cleared */
  .recently-viewed-wrapper {
    max-height: 1000px;
    opacity: 1;
    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .recently-viewed-wrapper.removing {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  @keyframes search-element-slide-up {
    from {
      opacity: 0;
      transform: translateY(8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-palette__group {
      animation: none;
    }

    .recently-viewed-wrapper {
      transition: none;
    }
  }
{% endstylesheet %}
