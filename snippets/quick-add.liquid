{%- doc -%}
  Renders a quick add component.

  @param {object} product - The product object
  @param {string} section_id - The section ID
  @param {object} [block] - The block object

  Renders one of: sold-out button, direct add, size pills (Size is the only option), or Choose (opens modal).
{%- enddoc -%}

{% liquid
  assign product_form_id = 'QuickAdd-ProductForm-' | append: product.id | append: '-' | append: block.id
  assign add_to_cart_text = 'actions.add' | t
  assign choose_options_text = 'actions.choose' | t
  # Logic to determine which variant to use (matching swatch selection logic from product-card)
  assign variant = product.selected_or_first_available_variant

  assign uses_selling_plans = false
  if product.requires_selling_plan or product.selling_plan_groups.size > 0
    assign uses_selling_plans = true
  endif

  if variant.available
    assign can_add_to_cart = true
  else
    assign can_add_to_cart = false
  endif

  # Which control the card gets is fixed at render:
  #   sold out        - no variant is available, so a disabled "Sold out" button
  #   add             - a single (default) variant adds straight to cart
  #   sizes           - "Size" is the only option, so each size is an add-to-cart pill
  #   choose          - anything else opens the quick-add modal
  # Selling plans always go to the PDP, since subscription widgets only run there.
  assign initial_button = 'choose'
  assign render_add = false
  assign render_choose = false
  assign render_sizes = false
  assign render_sold_out = false

  if product.available == false
    assign initial_button = 'sold-out'
    assign render_sold_out = true
  elsif uses_selling_plans
    assign render_choose = true
  elsif product.variants_count == 1
    assign initial_button = 'add'
    assign render_add = true
  elsif product.options.size == 1 and product.options_with_values.first.name == 'Size'
    assign initial_button = 'sizes'
    assign render_sizes = true
  else
    assign render_choose = true
  endif
%}

{% render 'fly-to-cart-styles' %}

{% comment %}
  Quick add shape (see the logic above):
    - Sold out: disabled "Sold out" button
    - One variant: "Add" button adds directly
    - Only option is Size: one pill per size, each adds that variant directly (unavailable sizes disabled)
    - Anything else (or selling plans): "Choose" button opens the quick-add modal

  The add-to-cart form is only rendered for the add and sizes shapes. The Choose and Sold out
  buttons never submit a form, so they live outside it.
{% endcomment %}
<quick-add-component
  class="quick-add custom-color-quick-add"
  ref="quickAdd"
  data-product-title="{{ product.title }}"
  data-product-id="{{ product.id }}"
  data-quick-add-button="{{ initial_button }}"
  data-product-options-count="{{ product.options.size }}"
  data-uses-selling-plans="{{ uses_selling_plans }}"
>
  {% if render_add or render_sizes %}
    <product-form-component
      data-section-id="{{ section_id }}"
      data-product-id="{{ product.id }}"
      on:submit="/handleSubmit"
      class="quick-add__product-form-component"
    >
      <div
        class="visually-hidden"
        aria-live="assertive"
        role="status"
        aria-atomic="true"
        ref="liveRegion"
      ></div>
      {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
        <input
          type="hidden"
          name="id"
          ref="variantId"
          value="{{ variant.id }}"
          {% if variant.available == false %}
            disabled
          {% endif %}
        >
        <input
          type="hidden"
          name="quantity"
          value="{% if variant.quantity_rule.min %}{{ variant.quantity_rule.min }}{% else %}1{% endif %}"
        >
        {% if render_sizes %}
          <div
            class="quick-add__sizes"
            role="group"
            aria-label="{{ 'actions.add' | t }}: {{ product.options_with_values.first.name | escape }}"
          >
            <div class="quick-add__sizes-label">QUICK ADD · SELECT SIZE</div>
            <div class="--size-button-wrapper">
              {% for size_variant in product.variants %}
                <button
                  type="button"
                  class="quick-add__size"
                  data-variant-id="{{ size_variant.id }}"
                  on:click="quick-add-component/handleSizeClick"
                  {% unless size_variant.available %}
                    disabled
                  {% endunless %}
                >
                  {% comment %} {{- size_variant.option1 -}} {% endcomment %}
                  {% render 'custom-stripped-value-label' , value: size_variant.option1 %}
                </button>
              {% endfor %}
            </div>
          </div>
        {% else %}
          {% render 'add-to-cart-button',
            add_to_cart_text: add_to_cart_text,
            class: 'quick-add__button quick-add__button--add add-to-cart-button',
            can_add_to_cart: can_add_to_cart,
            show_icon: true,
            product: product
          %}
        {% endif %}
      {%- endform -%}
    </product-form-component>
  {% endif %}

  {% if render_sold_out %}
    <button
      type="button"
      class="button quick-add__button quick-add__button--sold-out add-to-cart-button"
      disabled
    >
      {{- 'actions.sold_out' | t -}}
    </button>
  {% endif %}

  {% if render_choose %}
    <button
      class="button quick-add__button quick-add__button--choose add-to-cart-button"
      name="add"
      on:click="quick-add-component/handleClick"
    >
      {{- choose_options_text -}}
    </button>
  {% endif %}
</quick-add-component>

{% render 'add-to-cart-button-styles' %}
{% render 'checkbox-styles' %}
{% render 'text-block-styles' %}
{% render 'price-styles' %}
{% if render_choose %}
  {% render 'variant-picker-styles' %}
{% endif %}
{% render 'quick-add-styles' %}
{% render 'video-background-styles' %}
{% render 'video-placeholder-styles' %}
{% render 'deferred-media-product-model-styles' %}
