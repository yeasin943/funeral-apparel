{% render 'text-component-shimmer-styles' %}
{% render 'cart-typography-styles' %}

{%- liquid
  assign compare_total = 0
  for item in cart.items
    assign unit_compare = 0
    if item.variant.compare_at_price > item.original_price
      assign unit_compare = item.variant.compare_at_price
    elsif item.original_price > item.final_price
      assign unit_compare = item.original_price
    endif

    if unit_compare > item.final_price
      assign line_compare = unit_compare | times: item.quantity
      assign compare_total = compare_total | plus: line_compare
    else
      assign compare_total = compare_total | plus: item.final_line_price
    endif
  endfor

  assign total_savings = compare_total | minus: cart.total_price

  if settings.currency_code_enabled_cart_total
    assign total_price = cart.total_price | money_with_currency
    assign compare_total_price = compare_total | money_with_currency
    assign savings_price = total_savings | money_with_currency
  else
    assign total_price = cart.total_price | money
    assign compare_total_price = compare_total | money
    assign savings_price = total_savings | money
  endif

  assign total_price_plain = total_price | strip_html
  assign savings_price_plain = savings_price | strip_html
-%}

<div class="cart-drawer-cro__summary">
  {%- if settings.show_cart_note or settings.show_add_discount_code -%}
    <div class="cart-actions">
      {%- if settings.show_cart_note -%}
        <cart-note style="display: flex;">
          {% capture cart_note_accordion_children %}
            <details
              {% if settings.cart_note_open_by_default %}
                open
              {% endif %}
            >
              <summary class="cart-note__summary">
                <span class="cart-note__label cart-primary-typography">
                  {{ 'content.seller_note' | t }}
                </span>
                <span class="cart-totals__icon">
                  {{- 'icon-plus.svg' | inline_asset_content -}}
                </span>
              </summary>
              <div class="details-content cart-note__inner">
                <label
                  for="cart-note"
                  class="visually-hidden"
                >
                  {{- 'content.seller_note' | t -}}
                </label>
                <textarea
                  form="cart-form"
                  on:input="/updateCartNote"
                  id="cart-note"
                  class="cart-note__instructions"
                  name="note"
                  data-skip-node-update
                >{{ cart.note }}</textarea>
              </div>
            </details>
          {% endcapture %}
          {% render 'accordion-custom-component',
            children: cart_note_accordion_children,
            class: 'cart-note',
            open_by_default_on_desktop: settings.cart_note_open_by_default,
            open_by_default_on_mobile: settings.cart_note_open_by_default
          %}
        </cart-note>
      {%- endif -%}

      {%- if settings.show_cart_note and settings.show_add_discount_code -%}
        <div class="cart-actions__divider"></div>
      {%- endif -%}

      {%- if settings.show_add_discount_code -%}
        {%- liquid
          assign discount_codes = cart.cart_level_discount_applications | where: 'type', 'discount_code' | map: 'title'
          for item in cart.items
            for allocation in item.line_level_discount_allocations
              if allocation.discount_application.type == 'discount_code'
                assign discount_codes = item.line_level_discount_allocations | slice: forloop.index0 | map: 'discount_application' | map: 'title' | concat: discount_codes
              endif
            endfor
          endfor
          assign discount_codes = discount_codes | uniq

          if discount_codes.size == 0
            assign disclosure_expanded = false
          else
            assign disclosure_expanded = true
          endif
        -%}
        {% capture cart_discount_accordion_children %}
          <details
            {% if disclosure_expanded %}
              open
            {% endif %}
          >
            <summary class="cart-discount__summary">
              <span class="cart-discount__label cart-primary-typography">{{ 'content.discount' | t }}</span>
              <span class="cart-totals__icon">
                {{- 'icon-plus.svg' | inline_asset_content -}}
              </span>
            </summary>
            <div class="details-content">
              <div id="cart-discount-disclosure">
                <cart-discount-component data-section-id="cart-drawer-section">
                  <div class="cart-discount__content">
                    <form
                      on:submit="/applyDiscount"
                      onsubmit="return false;"
                      class="cart-discount__form"
                    >
                      <label
                        for="cart-discount"
                        class="visually-hidden"
                      >
                        {{- 'accessibility.discount' | t -}}
                      </label>
                      <input
                        id="cart-discount"
                        class="cart-discount__input"
                        type="text"
                        name="discount"
                        size="8"
                        placeholder="{{ 'content.discount_code' | t }}"
                        required
                        data-skip-node-update
                      >
                      <button
                        type="submit"
                        class="button cart-discount__button"
                      >
                        {{ 'actions.apply' | t }}
                      </button>
                    </form>
                  </div>
                  <div
                    class="cart-discount__error hidden"
                    role="alert"
                    ref="cartDiscountError"
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    <small
                      class="cart-discount__error-text cart-primary-typography hidden"
                      ref="cartDiscountErrorDiscountCode"
                    >
                      {{ 'content.discount_code_error' | t: code: 'test' }}
                    </small>
                    <small
                      class="cart-discount__error-text cart-primary-typography hidden"
                      ref="cartDiscountErrorShipping"
                    >
                      {{ 'content.shipping_discount_error' | t }}
                    </small>
                  </div>
                  <ul class="cart-discount__codes">
                    {%- for discount_code in discount_codes -%}
                      <li
                        class="cart-discount__pill"
                        data-discount-code="{{ discount_code }}"
                        aria-label="{{ 'accessibility.discount_applied' | t: code: discount_code }}"
                      >
                        <p class="cart-discount__pill-code">
                          <bdi>{{ discount_code }}</bdi>
                        </p>
                        <button
                          type="button"
                          on:click="/removeDiscount"
                          class="cart-discount__pill-remove svg-wrapper svg-wrapper--smaller button-unstyled"
                          aria-label="{{ 'actions.remove_discount' | t: code: discount_code }}"
                        >
                          {{- 'icon-filters-close.svg' | inline_asset_content -}}
                        </button>
                      </li>
                    {%- endfor -%}
                  </ul>
                </cart-discount-component>
              </div>
            </div>
          </details>
        {% endcapture %}
        {% render 'accordion-custom-component', children: cart_discount_accordion_children, class: 'cart-discount' %}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div
    class="cart-drawer-cro__totals"
    role="status"
  >
    <div class="cart-drawer-cro__totals-row">
      <span class="cart-drawer-cro__totals-label">{{ 'cart_drawer.subtotal' | t }}</span>
      <text-component
        ref="cartTotal"
        value="{{ total_price_plain }}"
        class="cart-drawer-cro__totals-value"
        data-cart-subtotal
      >
        <s class="cart-drawer-cro__compare">
          <span class="visually-hidden">{{ 'content.price_regular' | t }}</span>
          <bdi>{{ compare_total_price }}</bdi>
        </s>
        <bdi>{{ total_price }}</bdi>
      </text-component>
    </div>

    <div class="cart-drawer-cro__totals-row cart-drawer-cro__totals-row--meta">
      <span class="cart-drawer-cro__tax">
        {% render 'tax-info', has_discounts_enabled: settings.show_add_discount_code %}
      </span>
      {%- if total_savings > 0 -%}
        <span class="cart-drawer-cro__savings">
          <span class="cart-drawer-cro__you-save">
            {{- 'cart_drawer.you_save' | t: amount: savings_price_plain -}}
          </span>
        </span>
      {%- endif -%}
    </div>

    {%- if settings.show_installments -%}
      <div class="cart-drawer-cro__installments">
        {% form 'cart', cart %}
          {{ form | payment_terms }}
        {% endform %}
      </div>
    {%- endif -%}
  </div>

  <div class="cart-drawer-cro__ctas">
    <button
      type="submit"
      id="checkout"
      class="button cart__checkout-button cart-drawer-cro__checkout"
      name="checkout"
      form="cart-form"
      {% if cart == empty %}
        disabled
      {% endif %}
    >
      <span class="button-text">{{ 'cart_drawer.checkout_total' | t: total: total_price_plain }}</span>
    </button>

    {%- if additional_checkout_buttons and settings.show_accelerated_checkout_buttons -%}
      <p class="cart-drawer-cro__or">
        <span>{{ 'cart_drawer.or_pay_with' | t }}</span>
      </p>
      <div class="additional-checkout-buttons cart-drawer-cro__express">
        {{ content_for_additional_checkout_buttons }}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .cart-drawer-cro__summary {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    width: 100%;
  }

  .cart-drawer-cro__summary .cart-actions {
    margin-block-start: 0;
  }

  .cart-drawer-cro__totals {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
  }

  .cart-drawer-cro__totals-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--gap-md);
  }

  .cart-drawer-cro__totals-label {
    font-size: var(--font-size--md);
  }

  .cart-drawer-cro__totals-value {
    font-size: var(--font-size--xl);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cart-drawer-cro__totals-row--meta {
    flex-wrap: wrap;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  .cart-drawer-cro__tax,
  .cart-drawer-cro__tax * {
    font-size: var(--font-size--xs);
  }

  .cart-drawer-cro__tax a {
    color: inherit;
  }

  .cart-drawer-cro__savings {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
    margin-inline-start: auto;
    font-size: var(--font-size--xs);
  }

  .cart-drawer-cro__you-save {
    color: var(--cd-accent);
  }

  .cart-drawer-cro__installments {
    font-size: var(--font-size--2xs);
  }

  .cart-drawer-cro__ctas {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .cart-drawer-cro__checkout {
    width: 100%;
    min-height: 3.25rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cart-drawer-cro__or {
    display: flex;
    align-items: center;
    gap: var(--gap-md);
    margin: 0;
    font-size: var(--font-size--xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .cart-drawer-cro__or::before,
  .cart-drawer-cro__or::after {
    content: '';
    flex: 1;
    border-block-start: 1px solid var(--cd-divider);
  }

  .cart-drawer-cro__express shopify-accelerated-checkout-cart {
    --shopify-accelerated-checkout-inline-alignment: center;
    --shopify-accelerated-checkout-button-block-size: 2.75rem;
    --shopify-accelerated-checkout-button-border-radius: 0;
    --shopify-accelerated-checkout-row-gap: 0.5rem;
  }

    .cart-drawer-cro__summary .cart-actions {
    display: none;
    flex-direction: column;
    gap: 0;
    padding-block: 0;
    border-block: 1px solid var(--cd-divider);
  }

  .cart-actions__divider {
    border-block-start: 1px solid var(--cd-divider);
  }

  .cart-actions summary {
    min-height: var(--minimum-touch-target);
    padding-inline: 0;
    padding-block: var(--padding-sm);
    line-height: 1.2;
  }

  .cart-totals__icon {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    margin: 0;
  }

  .cart-note {
    width: 100%;
  }

  @starting-style {
    .cart-note[open-by-default-on-desktop][open-by-default-on-mobile] .details-content {
      block-size: auto;
      opacity: 1;
      overflow-y: visible;
    }
  }

  .cart-note__inner {
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  .cart-note__summary,
  .cart-discount__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-note__summary:hover,
  .cart-discount__summary:hover {
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .cart-note__label,
  .cart-discount__label {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-2xs);
    font-size: var(--font-size--2xs);
    font-weight: 500;
  }

  .cart-note__instructions {
    min-width: 100%;
    max-width: 100%;
    min-height: 5.5rem;
    padding: max(4px, calc(var(--style-border-radius-inputs) * (1 - cos(45deg))));
    border-width: var(--style-border-width-inputs);
    border-color: var(--color-input-border);
    background-color: var(--color-input-background);
    color: var(--color-input-text);
    font-size: var(--font-size--sm);
    box-shadow: var(--input-box-shadow);
    transition: box-shadow var(--animation-speed) ease;
  }

  .cart-discount {
    width: 100%;
  }

  .cart-discount__content {
    height: calc(var(--button-size) + var(--padding-2xs) + var(--padding-sm));
  }

  .cart-discount__form {
    display: flex;
    align-items: center;
    gap: var(--padding-md);
    height: 100%;
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  .cart-discount__input {
    flex-grow: 1;
    min-width: 0;
    height: 100%;
    padding: var(--padding-sm) var(--padding-md);
    border-width: var(--style-border-width-inputs);
    border-style: solid;
    border-color: var(--color-input-border);
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-input-background);
    color: var(--color-input-text);
    font-size: var(--font-size--sm);
  }

  .cart-discount__input::placeholder {
    color: rgb(var(--color-input-text-rgb) / var(--opacity-subdued-text));
  }

  .cart-discount__button {
    height: 100%;
  }

  .cart-discount__codes {
    display: none;
    flex-wrap: wrap;
    gap: var(--padding-xs);
    margin: 0;
    padding-inline: 0;
    list-style: none;
  }

  .cart-discount__codes:has(.cart-discount__pill) {
    display: flex;
    padding-block-end: var(--padding-sm);
  }

  .cart-discount__pill {
    display: flex;
    align-items: center;
    gap: var(--padding-xs);
    padding: var(--padding-xs) var(--padding-sm);
    border-radius: var(--style-border-radius-pills);
    background-color: var(--color-input-background);
    color: var(--color-foreground);
    text-transform: uppercase;
  }

  .cart-discount__pill-code {
    max-width: 100px;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :is(.cart-discount__pill-remove, .cart-discount__pill-remove:hover) {
    --close-icon-opacity: 0.4;

    height: 100%;
    background-color: transparent;
    color: var(--color-foreground);
    cursor: pointer;
    pointer-events: all;
  }

  .cart-discount__error {
    display: flex;
    align-items: center;
    width: 100%;
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  .cart-discount__error .svg-wrapper {
    flex-shrink: 0;
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    margin-inline: var(--margin-3xs) var(--margin-xs);
  }

  .cart-discount__error-text {
    margin-block-start: var(--margin-3xs);
  }
{% endstylesheet %}
