{% doc %}
  Renders the search modal dialog with predictive search.

  @param {block} [block] - The block object, used for Shopify editor attributes.
  @param {string} [class] - Additional CSS classes to apply to the predictive search component.
{% enddoc %}

{% render 'dialog-styles' %}
{% render 'predictive-search-styles' %}

{%- liquid
  # Resource types the predictive search requests; query suggestions show on mobile only.
  assign resource_types = 'product,query'
  if settings.search_show_collections
    assign resource_types = resource_types | append: ',collection'
  endif
  if settings.search_show_pages
    assign resource_types = resource_types | append: ',page'
  endif
  if settings.search_show_articles
    assign resource_types = resource_types | append: ',article'
  endif
-%}

<script
  src="{{ 'dialog.js' | asset_url }}"
  type="module"
></script>

<script
  src="{{ 'predictive-search.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<dialog-component
  id="search-modal"
  class="search-modal"
  {{ block.shopify_attributes }}
>
  <dialog
    ref="dialog"
    on:click="/closeDialogOnClickOutside"
    on:keydown="/closeDialogOnEscapePress"
    class="search-modal__content dialog-modal"
    scroll-lock
    aria-labelledby="search-modal-heading"
  >
    <h2
      id="search-modal-heading"
      class="visually-hidden"
    >
      {{ 'content.search' | t }}
    </h2>
    <predictive-search-component
      class="predictive-search color-custom-popover{% if class != blank %} {{ class | strip }}{% endif %}"
      style="--product-corner-radius: {{ settings.product_corner_radius | default: 8 | append: 'px' }}; --card-corner-radius: {{ settings.card_corner_radius | default: 8 | append: 'px' }};{% if settings.card_title_case == 'uppercase' %} --title-case: uppercase;{% endif %}"
      data-section-id="predictive-search"
      data-resource-types="{{ resource_types }}"
      data-testid="{{ 'search-component--modal' }}"
      role="search"
      aria-label="{{ 'content.search_input_label' | t }}"
    >
      <form
        action="{{ routes.search_url }}"
        method="get"
        role="search"
        class="predictive-search-form"
        ref="form"
        on:keydown="/onSearchKeyDown"
      >
        <div
          class="predictive-search-form__header"
        >
          <div class="predictive-search-form__header-inner">
            <label
              for="{{ 'cmdk-input' | default: 'Search' }}"
              class="visually-hidden"
            >
              {{- 'content.search_input_label' | t -}}
            </label>
            <input
              class="search-input"
              id="{{ 'cmdk-input' | default: 'Search' }}"
              type="search"
              name="q"
              role="combobox"
              aria-expanded="false"
              aria-owns="predictive-search-results"
              aria-controls="predictive-search-results"
              aria-haspopup="listbox"
              aria-autocomplete="list"
              autocomplete="off"
              placeholder="{{ 'content.search_input_placeholder' | t }}"
              ref="searchInput"
              on:input="/search"
              on:keydown="/onSearchKeyDown"
            >
            <input
              name="options[prefix]"
              type="hidden"
              value="last"
            >
            <span class="svg-wrapper predictive-search__icon">
              {{ 'icon-search-line.svg' | inline_asset_content }}
            </span>
            <button
              type="button"
              class="button-unstyled predictive-search__reset-button"
              ref="resetButton"
              hidden
              on:click="/resetSearch"
            >
              {{ 'actions.clear' | t }}
            </button>
          </div>
          <button
            type="button"
            class="button predictive-search__close-modal-button"
            aria-label="{{ 'accessibility.close_dialog' | t }}"
            on:click="dialog-component/closeDialog"
            ref="closeModalButton"
          >
            <span class="svg-wrapper">
              {{ 'icon-close-line.svg' | inline_asset_content }}
            </span>
          </button>
        </div>

        <div class="predictive-search-form__content-wrapper">
          <div
            class="predictive-search-form__content"
            ref="predictiveSearchResults"
            on:click="/handleModalClick"
          >
            {% render 'predictive-search-empty-state',
              load_empty_state: true,
              shadow_opacity: 0.1,
              products_test_id: 'products-list-default--modal'
            %}
          </div>
        </div>
      </form>
    </predictive-search-component>
  </dialog>
</dialog-component>

{% stylesheet %}
  /* Search palette (Figma "Search B" on desktop, "Search v1" on mobile).
     Figma-only neutrals are scoped here; ink and paper follow the color scheme. */
  .search-modal {
    --search-palette-ink: var(--color-foreground);
    --search-palette-muted: rgb(var(--color-foreground-rgb) / 0.65);
    --search-palette-ash: #cbc5ba;
    --search-palette-line: #efefef;
    --search-palette-bone: #fdfdf5;
    --search-palette-media: #f5f5f2;
    --search-palette-sale: #a3121c;
    --search-palette-scrim: rgb(11 11 11 / var(--opacity-40));
  }

  /* --search-palette-top / --search-palette-backdrop-top are set by predictive-search.js
     from the header's position when the dialog opens. */
  .search-modal__content.dialog-modal {
    display: none;
    flex-direction: column;
    width: min(680px, calc(100vw - 2rem));
    max-width: none;
    height: auto;
    max-height: calc(100dvh - var(--search-palette-top, 0px) - 24px);
    margin: var(--search-palette-top, 0px) auto auto;

    /* A modal dialog is pinned to both edges; release the bottom so content sets the height */
    inset-block-end: auto;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 0;
    background-color: var(--color-background);
    box-shadow: 0 24px 64px rgb(0 0 0 / 0.18);

    @media screen and (max-width: 749px) {
      width: 100%;
      max-height: calc(100dvh - var(--search-palette-top, 0px));
      margin: var(--search-palette-top, 0px) 0 auto;
      padding-block-start: max(0px, calc(var(--safe-area-inset-top, 0px) - var(--search-palette-top, 0px)));
      box-shadow: 0 20px 48px rgb(0 0 0 / 0.14);
    }
  }

  .search-modal__content.dialog-modal[open] {
    display: flex;
    border-radius: 0;
    transform-origin: top center;
    animation: search-element-slide-in-bottom 300ms var(--ease-out-quad) forwards;
  }

  .search-modal__content.dialog-modal.dialog-closing {
    animation: search-element-slide-out-bottom 200ms var(--ease-out-quad) forwards;
  }

  /* Scrim under the header: 40% ink + 4px blur on desktop; the mobile sheet leaves the
     page visible. A tap outside the palette still closes it (dialog-component). */
  .search-modal__content.dialog-modal::backdrop,
  .search-modal__content.dialog-modal[open]::backdrop {
    inset-block-start: var(--search-palette-backdrop-top, 0px);
    background: var(--search-palette-scrim, rgb(11 11 11 / 0.4));
    backdrop-filter: blur(4px);
    animation: none;
    transition: opacity var(--animation-speed) var(--animation-easing);
  }

  @media screen and (max-width: 749px) {
    .search-modal__content.dialog-modal::backdrop,
    .search-modal__content.dialog-modal[open]::backdrop {
      background: transparent;
      backdrop-filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-modal__content.dialog-modal[open],
    .search-modal__content.dialog-modal.dialog-closing {
      animation-duration: 1ms;
    }
  }

  predictive-search-component {
    display: flex;
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    background-color: var(--color-background);
  }

  .predictive-search-form {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
  }

  /* Input row */
  .predictive-search-form__header {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 14px;
    height: 64px;
    padding-inline: 24px 12px;
    border-block-end: 1px solid var(--search-palette-line);
    background-color: var(--color-background);

    @media screen and (max-width: 749px) {
      gap: 12px;
      height: 60px;
      padding-inline: 16px 10px;
      border-block-end: 1.5px solid var(--search-palette-ink);
    }
  }

  .predictive-search-form__header-inner {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    gap: 14px;
    min-width: 0;

    @media screen and (max-width: 749px) {
      gap: 12px;
    }
  }

  .predictive-search__icon {
    display: flex;
    flex-shrink: 0;
    order: -1;
    width: 20px;
    height: 20px;
    color: var(--search-palette-ink);

    svg {
      width: 100%;
      height: 100%;
    }
  }

  input.search-input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-weight: var(--font-body--weight);
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--search-palette-ink);
    caret-color: var(--search-palette-ink);
    text-overflow: ellipsis;
    outline: none;
    box-shadow: none;

    &::placeholder {
      color: var(--search-palette-muted);
      opacity: 1;
    }

    &:hover,
    &:is(:focus, :focus-visible) {
      background: transparent;
      outline: none;
      box-shadow: none;
    }

    &::-webkit-search-cancel-button,
    &::-webkit-search-decoration {
      -webkit-appearance: none; /* stylelint-disable-line */
    }
  }

  /* Search B has no clear control in the input row; Escape and the close button reset. */
  .predictive-search__reset-button {
    display: none;
  }

  .predictive-search__close-modal-button.button {
    --button-color: var(--search-palette-ink);
    --button-background-color: transparent;

    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border-radius: 0;
    box-shadow: none;
    color: var(--search-palette-ink);

    .svg-wrapper,
    svg {
      width: 20px;
      height: 20px;
    }

    &:hover {
      --button-background-color: transparent;
      --button-color: var(--search-palette-ink);
    }

    /* 36px in the mobile layout, with a 44px hit area */
    @media screen and (max-width: 749px) {
      margin-inline: -4px;

      .svg-wrapper,
      svg {
        width: 18px;
        height: 18px;
      }
    }
  }

  .predictive-search-form__content-wrapper {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
  }

  .predictive-search-form__content {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
    background-color: var(--color-background);
  }
{% endstylesheet %}
