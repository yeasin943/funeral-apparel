<style>
    .--pdp-badge.product-badges.product-badges--top-left{
        left: 10px;
        top: 10px;

    }

{% comment %} Price Block Badge     {% endcomment %}
product-price {
  .--pdp-badge.product-badges.product-badges--top-left {
        position: relative;
        left: unset;
        top: unset;
      }
    }
</style>
<div
  class=" --pdp-badge product-badges product-badges--top-left
    product-badges__badge product-badges__badge--rectangle
    {% if product.available == false %} color-custom-badge-sold-out{% elsif product.compare_at_price > product.price %} color-custom-badge-sale{% endif %}
  "
>
  {%- if product.available == false -%}
    {{ 'content.product_badge_sold_out' | t }}
  {%- elsif product.compare_at_price > product.price -%}
    {%- assign savings = product.compare_at_price | minus: product.price -%}
    {%- assign percent_off = savings | times: 100.0 | divided_by: product.compare_at_price | round -%}
    {{ percent_off }}% off
  {%- endif -%}
</div>
