      "visible_if": "{{ section.settings.show_quickadd }}"
    },
    {
      "type": "text",
      "id": "variant_picker_heading",
      "label": "Variant selector heading",
      "default": "Select",
      "info": "The option name is added automatically, for example \"Select Size\".",
      "visible_if": "{{ section.settings.show_quickadd }}"
    },
    {
      "type": "select",
      "id": "cart_app",
      "label": "Cart app",
      "default": "auto-detect",
      "options": [
        { "label": "Auto-detect", "value": "auto-detect" },
        { "label": "UpCart", "value": "upcart" },
        { "label": "AMP Cart", "value": "amp-cart" },
        { "label": "Kaching Cart", "value": "kaching-cart" },
        { "label": "None", "value": "none" }
      ],
      "visible_if": "{{ section.settings.show_quickadd }}"
    },
    {
      "type": "checkbox",
      "id": "show_price_compare",
