{% schema %}
{
  "name": "SS - Featured tabs pro 💎",
  "max_blocks": 11,
  "settings": [
    {
      "type": "header",
      "content": "Tabs"
    },
    {
      "type": "text_alignment",
      "id": "tabs_align",
      "label": "Alignment",
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "tabs_fade",
      "label": "Fade tabs on sides when scrollable",
      "default": true
    },
    {
      "type": "range",
      "id": "tabs_fade_width",
      "min": 8,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Fade width",
      "default": 28,
      "visible_if": "{{ section.settings.tabs_fade }}"
    },
    {
      "type": "checkbox",
      "id": "tabs_advanced",
      "label": "Show advanced settings",
      "default": false
    },
    {
      "type": "range",
      "id": "tabs_gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Gap",
      "default": 10,
      "visible_if": "{{ section.settings.tabs_advanced }}"
    },
    {
      "type": "range",
      "id": "tabs_gap_mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Gap - mobile",
      "default": 8,
      "visible_if": "{{ section.settings.tabs_advanced }}"
    },
    {
      "type": "range",
      "id": "tabs_mt",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Top spacing",
      "default": 40,
      "visible_if": "{{ section.settings.tabs_advanced }}"
    },
    {
      "type": "range",
      "id": "tabs_mt_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Top spacing - mobile",
      "default": 24,
      "visible_if": "{{ section.settings.tabs_advanced }}"
    },
    {
      "type": "header",
      "content": "Tab button"
    },
    {
      "type": "checkbox",
      "id": "tab_custom",
      "label": "Use custom font",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "tab_font",
      "label": "Font family",
      "default": "josefin_sans_n4",
      "visible_if": "{{ section.settings.tab_custom }}"
    },
    {
      "type": "range",
      "id": "tab_size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "tab_size_mobile",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Font size - mobile",
      "default": 15
    },
    {
      "type": "range",
      "id": "tab_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Roundness",
      "default": 8
    },
    {
      "type": "range",
      "id": "tab_border_thickness",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border thickness",
      "default": 1
    },
    {
      "type": "select",
      "id": "tab_border_style",
      "label": "Border style",
      "default": "dashed",
      "options": [
        { "label": "Solid", "value": "solid" },
        { "label": "Dashed", "value": "dashed" },
        { "label": "Dotted", "value": "dotted" }
      ],
      "visible_if": "{{ section.settings.tab_border_thickness > 0 }}"
    },
    {
      "type": "checkbox",
      "id": "tab_advanced",
      "label": "Show advanced settings",
      "default": false
    },
    {
      "type": "range",
      "id": "tab_height",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "%",
      "label": "Line height",
      "default": 130,
      "visible_if": "{{ section.settings.tab_advanced }}"
    },
    {
      "type": "range",
      "id": "tab_padding_horizontal",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Padding sides",
      "default": 22,
      "visible_if": "{{ section.settings.tab_advanced }}"
    },
    {
      "type": "range",
      "id": "tab_padding_horizontal_mobile",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Padding sides - mobile",
      "default": 16,
      "visible_if": "{{ section.settings.tab_advanced }}"
    },
    {
      "type": "range",
      "id": "tab_padding_vertical",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Padding top and bottom",
      "default": 14,
      "visible_if": "{{ section.settings.tab_advanced }}"
    },
    {
      "type": "range",
      "id": "tab_padding_vertical_mobile",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Padding top and bottom - mobile",
      "default": 12,
      "visible_if": "{{ section.settings.tab_advanced }}"
    },
    {
      "type": "header",
      "content": "Arrows"
    },
    {
      "type": "checkbox",
      "id": "arrow_show_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "arrow_show_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "arrow_size",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Size",
      "default": 46,
      "visible_if": "{{ section.settings.arrow_show_desktop }}"
    },
    {
      "type": "range",
      "id": "arrow_size_mobile",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Size - mobile",
      "default": 40,
      "visible_if": "{{ section.settings.arrow_show_mobile }}"
    },
    {
      "type": "range",
      "id": "arrow_icon_size",
      "min": 4,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Icon size",
      "default": 8,
      "visible_if": "{{ section.settings.arrow_show_desktop }}"
    },
    {
      "type": "range",
      "id": "arrow_icon_size_mobile",
      "min": 4,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Icon size - mobile",
      "default": 8,
      "visible_if": "{{ section.settings.arrow_show_mobile }}"
    },
    {
      "type": "range",
      "id": "arrow_border_thickness",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border thickness",
      "default": 1,
      "visible_if": "{{ section.settings.arrow_show_desktop or section.settings.arrow_show_mobile }}"
    },
    {
      "type": "range",
      "id": "arrow_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Roundness",
      "default": 100,
      "visible_if": "{{ section.settings.arrow_show_desktop or section.settings.arrow_show_mobile }}"
    },
    {
      "type": "select",
      "id": "arrow_hover_effect",
      "label": "Hover effect",
      "default": "color",
      "options": [
        { "label": "Color", "value": "color" },
        { "label": "Scale", "value": "scale" },
        { "label": "Arrow", "value": "arrow" },
        { "label": "None", "value": "none" }
      ],
      "visible_if": "{{ section.settings.arrow_show_desktop or section.settings.arrow_show_mobile }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "layout_advanced",
      "label": "Show advanced settings",
      "default": false
    },
    {
      "type": "range",
      "id": "cards_per_view",
      "min": 1,
      "max": 8,
      "step": 0.1,
      "label": "Columns",
      "default": 4
    },
    {
      "type": "range",
      "id": "cards_per_view_mobile",
      "min": 1,
      "max": 4,
      "step": 0.1,
      "label": "Columns - mobile",
      "default": 1.6,
      "visible_if": "{{ section.settings.layout_advanced }}"
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Gap",
      "default": 16,
      "visible_if": "{{ section.settings.layout_advanced }}"
    },
    {
      "type": "range",
      "id": "card_gap_mobile",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Gap - mobile",
      "default": 12,
      "visible_if": "{{ section.settings.layout_advanced }}"
    },
    {
      "type": "range",
      "id": "row_mt",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top spacing",
      "default": 40,
      "visible_if": "{{ section.settings.layout_advanced }}"
    },
    {
      "type": "range",
      "id": "row_mt_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top spacing - mobile",
      "default": 28,
      "visible_if": "{{ section.settings.layout_advanced }}"
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open links in a new tab",
      "default": false
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Roundness",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_border_thickness",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border thickness",
      "default": 0
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_padding_mobile",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Padding - mobile",
      "default": 12
    },
    {
      "type": "header",
      "content": "Product image"
    },
    {
      "type": "checkbox",
      "id": "card_media_slider",
      "label": "Show image arrows - mobile",
      "default": true,
      "info": "Browse up to 5 product images. Arrows only appear on products with more than one image. Desktop keeps the hover effect."
    },
    {
      "type": "checkbox",
      "id": "image_hover_effect",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "image_zoom_hover",
      "label": "Zoom image on hover",
      "default": true,
      "info": "The image grows over the product title and stops just above the button. The amount is worked out per card."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Aspect ratio",
      "default": "square",
      "options": [
        { "label": "Portrait", "value": "portrait" },
        { "label": "Square", "value": "square" },
        { "label": "Landscape", "value": "landscape" }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio_mobile",
      "label": "Aspect ratio - mobile",
      "default": "square",
      "options": [
        { "label": "Portrait", "value": "portrait" },
        { "label": "Square", "value": "square" },
        { "label": "Landscape", "value": "landscape" }
      ]
    },
    {
      "type": "header",
      "content": "Product content"
    },
    {
      "type": "text_alignment",
      "id": "content_align",
      "label": "Alignment",
      "default": "left"
    },
    {
      "type": "text_alignment",
      "id": "content_align_mobile",
      "label": "Alignment - mobile",
      "default": "left"
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "paragraph",
      "content": "Read from the product's \"custom.badge\" metafield. Separate several badges with a comma."
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "badge_custom",
      "label": "Use custom font",
      "default": false,
      "visible_if": "{{ section.settings.show_badge }}"
    },
    {
      "type": "font_picker",
      "id": "badge_font",
      "label": "Font family",
      "default": "josefin_sans_n7",
      "visible_if": "{{ section.settings.show_badge and section.settings.badge_custom }}"
    },
    {
      "type": "range",
      "id": "badge_size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 13,
      "visible_if": "{{ section.settings.show_badge }}"
    },
    {
      "type": "range",
      "id": "badge_size_mobile",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size - mobile",
      "default": 12,
      "visible_if": "{{ section.settings.show_badge }}"
    },
    {
      "type": "range",
      "id": "badge_radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Roundness",
      "default": 6,
      "visible_if": "{{ section.settings.show_badge }}"
    },
    {
      "type": "range",
      "id": "badge_padding_horizontal",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Padding sides",
      "default": 10,
      "visible_if": "{{ section.settings.show_badge }}"
    },
    {
      "type": "range",
      "id": "badge_padding_vertical",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Padding top and bottom",
      "default": 8,
      "visible_if": "{{ section.settings.show_badge }}"
    },
    {
      "type": "range",
      "id": "badge_border_thickness",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border thickness",
      "default": 0,
      "visible_if": "{{ section.settings.show_badge }}"
    },
    {
      "type": "select",
      "id": "badge_border_style",
      "label": "Border style",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.show_badge and section.settings.badge_border_thickness > 0 }}"
    },
    {
      "type": "header",
      "content": "Product title"
    },
    {
      "type": "checkbox",
      "id": "title_custom",
      "label": "Use custom font",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Font family",
      "default": "josefin_sans_n4",
      "visible_if": "{{ section.settings.title_custom }}"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 22
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Font size - mobile",
      "default": 17
    },
    {
      "type": "checkbox",
      "id": "title_advanced",
      "label": "Show advanced settings",
      "default": false
    },
    {
      "type": "range",
      "id": "title_height",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "%",
      "label": "Line height",
      "default": 130,
      "visible_if": "{{ section.settings.title_advanced }}"
    },
    {
      "type": "range",
      "id": "title_mt",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Top spacing",
      "default": 8,
      "visible_if": "{{ section.settings.title_advanced }}"
    },
    {
      "type": "range",
      "id": "title_mt_mobile",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Top spacing - mobile",
      "default": 6,
      "visible_if": "{{ section.settings.title_advanced }}"
    },
    {
      "type": "header",
      "content": "Quick add"
    },
    {
      "type": "checkbox",
      "id": "show_quickadd",
      "label": "Show quick add button",
      "default": true
    },
    {
      "type": "text",
      "id": "quickadd_label",
      "label": "Label",
      "default": "Quick add",
      "visible_if": "{{ section.settings.show_quickadd }}"
    },
    {
      "type": "text",
      "id": "atc_soldout_label",
      "label": "Sold out label",
      "default": "Sold out",
      "visible_if": "{{ section.settings.show_quickadd }}"
    },
    {
      "type": "text",
      "id": "atc_added_label",
      "label": "Added to cart label",
