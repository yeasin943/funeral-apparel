    border-top: solid {{ border_color }} {{ border_thickness }}px;
    border-bottom: solid {{ border_color }} {{ border_thickness }}px;
    margin-top: {{ margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ margin_bottom | times: 0.75 | round: 0 }}px;
    margin-left: {{ margin_horizontal_mobile }}rem;
    margin-right: {{ margin_horizontal_mobile }}rem;
    border-radius: {{ section_radius | times: 0.6 | round: 0 }}px;
    overflow: hidden;
  }

  .section-{{ section.id }}-settings {
    margin: 0 auto;
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ padding_horizontal_mobile }}rem;
    padding-right: {{ padding_horizontal_mobile }}rem;
  }

  .faq-pro-body-{{ section.id }} {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "content"
      "tabs";
    gap: {{ layout_gap_mobile }}px;
    min-width: 0;
  }

  .faq-pro-content-{{ section.id }} {
    grid-area: content;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: start;
    min-width: 0;
  }

  .faq-pro-tabs-col-{{ section.id }} {
    grid-area: tabs;
    min-width: 0;
  }

  .faq-pro-toggles-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ toggles_gap_mobile }}px;
  }

  .faq-pro-toggle-{{ section.id }} {
    appearance: none;
    -webkit-appearance: none;
    padding: {{ toggle_padding_vertical_mobile }}px {{ toggle_padding_horizontal_mobile }}px;
    border-radius: {{ toggle_radius }}px;
    margin: 0px;
    max-width: 100%;
    font-family: inherit;
    font-size: {{ toggle_size_mobile }}px;
    font-weight: inherit;
    line-height: {{ toggle_height }}%;
    letter-spacing: inherit;
    text-align: center;
    text-transform: unset;
    word-break: break-word;
    cursor: pointer;
    transition: all 0.25s ease 0s;
    border: {{ toggle_border_thickness }}px solid {{ toggle_border_color }};
    {% if toggle_bg_style == 'gradient' %}
      background: {{ toggle_bg_gradient }};
    {% else %}
      background-color: {{ toggle_bg_color }};
    {% endif %}
    color: {{ toggle_color }};
  }

  .faq-pro-toggle-{{ section.id }}.active {
    {% if toggle_bg_style == 'gradient' %}
      background: {{ toggle_active_bg_gradient }};
    {% else %}
      background-color: {{ toggle_active_bg_color }};
    {% endif %}
    color: {{ toggle_active_color }};
    border-color: {{ toggle_active_border_color }};
  }

  .faq-pro-toggles-{{ section.id }} + .faq-pro-tabs-{{ section.id }} {
    margin-top: {{ tabs_mt_mobile }}px;
  }

  .faq-pro-tab-{{ section.id }} {
    display: none;
    flex-direction: column;
    gap: {{ item_mt_mobile }}px;
  }

  .faq-pro-tab-{{ section.id }}.active {
    display: flex;
  }

  .faq-pro-item-{{ section.id }} {
    padding: {{ item_padding_vertical_mobile }}px {{ item_padding_horizontal_mobile }}px;
    border-radius: {{ item_radius }}px;
    border: {{ item_border_thickness }}px solid {{ item_border_color }};
    position: relative;
    transition: all 0.25s ease 0s;
    background-color: {{ item_bg_color }};
  }

  .faq-pro-item-{{ section.id }}.active {
    background-color: {{ item_active_bg_color }};
    border-color: {{ item_active_border_color }};
  }

  .faq-pro-item-toggle-{{ section.id }} {
    appearance: none;
    -webkit-appearance: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
    text-align: start;
    cursor: pointer;
  }

  .faq-pro-item-toggle-{{ section.id }}::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .faq-pro-icon-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 {{ icon_size_mobile }}px;
    width: {{ icon_size_mobile }}px;
    height: {{ icon_size_mobile }}px;
    border-radius: {{ icon_radius }}px;
    border: {{ icon_border_thickness }}px solid {{ icon_border_color }};
    transition: all 0.25s ease 0s;
    background-color: {{ icon_bg_color }};
  }

  .faq-pro-item-{{ section.id }}.active .faq-pro-icon-{{ section.id }} {
    background-color: {{ icon_active_bg_color }};
  }

  .faq-pro-icon-{{ section.id }} svg path {
    fill: {{ icon_color }};
  }

  .faq-pro-item-{{ section.id }}.active .faq-pro-icon-{{ section.id }} svg path {
    fill: {{ icon_active_color }};
  }

  .faq-pro-icon-{{ section.id }} svg {
    width: 40%;
    height: 40%;
    transition: all 0.25s ease 0s;
  }

  .faq-pro-item-{{ section.id }}.active .faq-pro-icon-{{ section.id }} svg {
    transform: rotate(180deg);
  }

  .faq-pro-question-{{ section.id }} {
    margin: 0px;
    font-size: {{ question_size_mobile }}px;
    line-height: {{ question_height }}%;
    text-transform: unset;
    font-weight: 700;
    color: {{ question_color }};
  }

  .faq-pro-answer-{{ section.id }} {
    position: relative;
    z-index: 1;
    box-sizing: border-box;
    transition: all 0.2s ease-in-out;
    overflow: hidden;
  }

  .faq-pro-answer-{{ section.id }} * {
    margin: 0px;
    font-size: {{ answer_size_mobile }}px;
    line-height: {{ answer_height }}%;
    text-transform: unset;
    color: {{ answer_color }};
  }

  .faq-pro-answer-{{ section.id }} p {
    min-height: 10px;
  }

  .faq-pro-answer-{{ section.id }} p:not(:first-child) {
    margin-top: 10px;
  }

  .faq-pro-height-cal-{{ section.id }} {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    top: 0;
    left: 0;
    width: calc(100% - {{ item_padding_horizontal_mobile | times: 2 }}px);
    padding-top: {{ answer_padding_top }}px;
  }

  .faq-pro-height-cal-{{ section.id }} * {
    margin: 0px;
    font-size: {{ answer_size_mobile }}px;
    line-height: {{ answer_height }}%;
    text-transform: unset;
    color: {{ answer_color }};
  }

  .faq-pro-height-cal-{{ section.id }} p {
    min-height: 10px;
  }

  .faq-pro-height-cal-{{ section.id }} p:not(:first-child) {
    margin-top: 10px;
  }

  .faq-pro-answer-{{ section.id }} strong,
  .faq-pro-answer-{{ section.id }} b,
  .faq-pro-height-cal-{{ section.id }} strong,
  .faq-pro-height-cal-{{ section.id }} b {
    font-weight: bolder;
  }

  .faq-pro-answer-{{ section.id }} em,
  .faq-pro-answer-{{ section.id }} i,
  .faq-pro-height-cal-{{ section.id }} em,
  .faq-pro-height-cal-{{ section.id }} i {
    font-style: italic;
  }

  .faq-pro-answer-{{ section.id }} strong *,
  .faq-pro-answer-{{ section.id }} b *,
  .faq-pro-height-cal-{{ section.id }} strong *,
  .faq-pro-height-cal-{{ section.id }} b * {
    font-weight: inherit;
  }

  .faq-pro-answer-{{ section.id }} em *,
  .faq-pro-answer-{{ section.id }} i *,
  .faq-pro-height-cal-{{ section.id }} em *,
  .faq-pro-height-cal-{{ section.id }} i * {
    font-style: inherit;
  }

  .faq-pro-answer-{{ section.id }} .faq-pro-answer-image-{{ section.id }},
  .faq-pro-height-cal-{{ section.id }} .faq-pro-answer-image-{{ section.id }} {
    display: block;
    width: {{ answer_image_width }}%;
    height: auto;
    border-radius: {{ answer_image_radius }}px;
    {% if answer_image_position == 'above' %}
      margin-bottom: {{ answer_image_mt }}px;
    {% else %}
      margin-top: {{ answer_image_mt }}px;
    {% endif %}
  }

  @media(min-width: 1024px) {

    .section-{{ section.id }} {
      margin-top: {{ margin_top }}px;
      margin-bottom: {{ margin_bottom }}px;
      margin-left: {{ margin_horizontal }}rem;
      margin-right: {{ margin_horizontal }}rem;
      border-radius: {{ section_radius }}px;
    }

    .section-{{ section.id }}-settings {
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
      padding-left: {{ padding_horizontal }}rem;
      padding-right: {{ padding_horizontal }}rem;
    }

    .faq-pro-body-{{ section.id }} {
      gap: {{ layout_gap }}px;
    }

    .faq-pro-toggles-{{ section.id }} {
      gap: {{ toggles_gap }}px;
    }

    .faq-pro-toggle-{{ section.id }} {
      padding: {{ toggle_padding_vertical }}px {{ toggle_padding_horizontal }}px;
      font-size: {{ toggle_size }}px;
    }

    .faq-pro-toggles-{{ section.id }} + .faq-pro-tabs-{{ section.id }} {
      margin-top: {{ tabs_mt }}px;
    }

    .faq-pro-tab-{{ section.id }} {
      gap: {{ item_mt }}px;
    }

    .faq-pro-item-{{ section.id }} {
      padding: {{ item_padding_vertical }}px {{ item_padding_horizontal }}px;
    }

    .faq-pro-icon-{{ section.id }} {
      flex: 0 0 {{ icon_size }}px;
      width: {{ icon_size }}px;
      height: {{ icon_size }}px;
    }

    .faq-pro-question-{{ section.id }} {
      font-size: {{ question_size }}px;
    }

    .faq-pro-answer-{{ section.id }} *,
    .faq-pro-height-cal-{{ section.id }} * {
      font-size: {{ answer_size }}px;
    }

    .faq-pro-height-cal-{{ section.id }} {
      width: calc(100% - {{ item_padding_horizontal | times: 2 }}px);
    }
  }

{%- endstyle -%}

{% if width == 'custom' %}
  <style>
    .section-{{ section.id }}-settings {
      max-width: {{ content_width }}px;
    }
  </style>
{% elsif width == 'page' %}
  <style>
    .section-{{ section.id }}-settings {
      max-width: clamp(100px, var(--page-content-width, var(--page-width)), 100%);
    }
  </style>
{% endif %}

{% if margin_horizontal_mobile > 0 %}
  <style>
    .section-{{ section.id }} {
      border-left: solid {{ border_color }} {{ border_thickness }}px;
      border-right: solid {{ border_color }} {{ border_thickness }}px;
    }

    @media(min-width: 1024px) {
      .section-{{ section.id }} {
        border-left: 0px;
        border-right: 0px;
      }
    }
  </style>
{% endif %}

{% if margin_horizontal > 0 %}
  <style>
    @media(min-width: 1024px) {
      .section-{{ section.id }} {
        border-left: solid {{ border_color }} {{ border_thickness }}px;
        border-right: solid {{ border_color }} {{ border_thickness }}px;
      }
    }
  </style>
{% endif %}

{% if layout_mobile == 'tabs_content' %}
  <style>
    .faq-pro-body-{{ section.id }} {
      grid-template-areas:
        "tabs"
        "content";
    }
  </style>
{% endif %}

{% if layout == 'content_tabs' %}
  <style>
    @media(min-width: 1024px) {
      .faq-pro-body-{{ section.id }} {
        grid-template-areas: "content tabs";
        grid-template-columns: minmax(0, {{ content_column_width }}%) minmax(0, 1fr);
      }
    }
  </style>
{% else %}
  <style>
    @media(min-width: 1024px) {
      .faq-pro-body-{{ section.id }} {
        grid-template-areas: "tabs content";
        grid-template-columns: minmax(0, 1fr) minmax(0, {{ content_column_width }}%);
      }
    }
  </style>
{% endif %}

{% if toggle_custom %}
  <style>
    {{ toggle_font | font_face: font_display: 'swap' }}

    .faq-pro-toggle-{{ section.id }} {
      font-family: {{ toggle_font.family }}, {{ toggle_font.fallback_families }};
      font-weight: {{ toggle_font.weight }};
      font-style: {{ toggle_font.style }};
    }
  </style>
{% endif %}

{% if question_custom %}
  <style>
    {{ question_font | font_face: font_display: 'swap' }}

    .faq-pro-question-{{ section.id }} {
      font-family: {{ question_font.family }}, {{ question_font.fallback_families }};
      font-weight: {{ question_font.weight }};
      font-style: {{ question_font.style }};
    }
  </style>
{% endif %}

{% if answer_custom %}
  <style>
    {{ answer_font | font_face: font_display: 'swap' }}
    {%- assign answer_font_bold = answer_font | font_modify: 'weight', 'bolder' -%}
    {%- if answer_font_bold -%}
      {{ answer_font_bold | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- assign answer_font_italic = answer_font | font_modify: 'style', 'italic' -%}
    {%- if answer_font_italic -%}
      {{ answer_font_italic | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- assign answer_font_bold_italic = answer_font_bold | font_modify: 'style', 'italic' -%}
    {%- if answer_font_bold_italic -%}
      {{ answer_font_bold_italic | font_face: font_display: 'swap' }}
    {%- endif -%}

    .faq-pro-answer-{{ section.id }} *,
    .faq-pro-height-cal-{{ section.id }} * {
      font-family: {{ answer_font.family }}, {{ answer_font.fallback_families }};
      font-weight: {{ answer_font.weight }};
      font-style: {{ answer_font.style }};
    }
  </style>
{% endif %}

{% for block in section.blocks %}
  {% case block.type %}
    {% when 'badge' %}
      <style>
        .faq-pro-badge-{{ block.id }} {
          margin: 0;
          margin-top: {{ block.settings.badge_mt_mobile }}px;
          font-size: {{ block.settings.badge_size_mobile }}px;
          color: {{ block.settings.badge_color }};
          line-height: 130%;
          text-transform: unset;
          text-decoration: none;
          word-break: break-word;
          font-weight: 600;
        }

        @media(min-width: 1024px) {
          .faq-pro-badge-{{ block.id }} {
            margin-top: {{ block.settings.badge_mt }}px;
            font-size: {{ block.settings.badge_size }}px;
          }
        }
      </style>
      {% if block.settings.badge_custom %}
        <style>
          {{ block.settings.badge_font | font_face: font_display: 'swap' }}

          .faq-pro-badge-{{ block.id }} {
            font-family: {{ block.settings.badge_font.family }}, {{ block.settings.badge_font.fallback_families }};
            font-weight: {{ block.settings.badge_font.weight }};
            font-style: {{ block.settings.badge_font.style }};
          }
        </style>
      {% endif %}

    {% when 'heading' %}
      <style>
        .faq-pro-heading-{{ block.id }} {
          width: 100%;
          margin-top: {{ block.settings.heading_mt_mobile }}px;
        }

        .faq-pro-heading-{{ block.id }} * {
          margin: 0;
          font-size: {{ block.settings.heading_size_mobile }}px;
          color: {{ block.settings.heading_color }};
          line-height: {{ block.settings.heading_height }}%;
          text-transform: unset;
          text-decoration: none;
          word-break: break-word;
          font-weight: 700;
        }

        .faq-pro-heading-{{ block.id }} * strong {
          {% if block.settings.heading_accent_color_style == 'gradient' %}
            background: {{ block.settings.heading_accent_gradient }};
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
          {% else %}
            color: {{ block.settings.heading_accent_color }};
          {% endif %}
        }

        .faq-pro-heading-{{ block.id }} em,
        .faq-pro-heading-{{ block.id }} i {
          font-style: italic;
        }

        .faq-pro-heading-{{ block.id }} em *,
        .faq-pro-heading-{{ block.id }} i * {
          font-style: inherit;
        }

        @media(min-width: 1024px) {
          .faq-pro-heading-{{ block.id }} {
            margin-top: {{ block.settings.heading_mt }}px;
          }

          .faq-pro-heading-{{ block.id }} * {
            font-size: {{ block.settings.heading_size }}px;
          }
        }
      </style>
      {% if block.settings.heading_custom %}
        <style>
          {{ block.settings.heading_font | font_face: font_display: 'swap' }}
          {%- assign heading_font_italic = block.settings.heading_font | font_modify: 'style', 'italic' -%}
          {%- if heading_font_italic -%}
            {{ heading_font_italic | font_face: font_display: 'swap' }}
          {%- endif -%}

          .faq-pro-heading-{{ block.id }} * {
            font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
            font-weight: {{ block.settings.heading_font.weight }};
            font-style: {{ block.settings.heading_font.style }};
          }
        </style>
      {% endif %}

    {% when 'text' %}
      <style>
        .faq-pro-text-{{ block.id }} {
          margin-top: {{ block.settings.text_mt_mobile }}px;
          max-width: {{ block.settings.text_max_width_mobile }}px;
        }

        .faq-pro-text-{{ block.id }} * {
          margin: 0;
          font-size: {{ block.settings.text_size_mobile }}px;
          color: {{ block.settings.text_color }};
          line-height: {{ block.settings.text_height }}%;
          text-transform: unset;
          text-decoration: none;
          word-break: break-word;
          font-weight: 400;
        }

        .faq-pro-text-{{ block.id }} strong,
        .faq-pro-text-{{ block.id }} b {
          font-weight: bolder;
        }

        .faq-pro-text-{{ block.id }} em,
        .faq-pro-text-{{ block.id }} i {
          font-style: italic;
        }

        .faq-pro-text-{{ block.id }} strong *,
        .faq-pro-text-{{ block.id }} b * {
          font-weight: inherit;
        }

        .faq-pro-text-{{ block.id }} em *,
        .faq-pro-text-{{ block.id }} i * {
          font-style: inherit;
        }

        @media(min-width: 1024px) {
          .faq-pro-text-{{ block.id }} {
            margin-top: {{ block.settings.text_mt }}px;
            max-width: {{ block.settings.text_max_width }}px;
          }

          .faq-pro-text-{{ block.id }} * {
            font-size: {{ block.settings.text_size }}px;
          }
        }
      </style>
      {% if block.settings.text_custom %}
        <style>
          {{ block.settings.text_font | font_face: font_display: 'swap' }}
          {%- assign text_font_bold = block.settings.text_font | font_modify: 'weight', 'bolder' -%}
          {%- if text_font_bold -%}
            {{ text_font_bold | font_face: font_display: 'swap' }}
          {%- endif -%}
          {%- assign text_font_italic = block.settings.text_font | font_modify: 'style', 'italic' -%}
          {%- if text_font_italic -%}
            {{ text_font_italic | font_face: font_display: 'swap' }}
          {%- endif -%}
          {%- assign text_font_bold_italic = text_font_bold | font_modify: 'style', 'italic' -%}
          {%- if text_font_bold_italic -%}
            {{ text_font_bold_italic | font_face: font_display: 'swap' }}
          {%- endif -%}

          .faq-pro-text-{{ block.id }} * {
            font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
            font-weight: {{ block.settings.text_font.weight }};
            font-style: {{ block.settings.text_font.style }};
          }
        </style>
      {% endif %}

    {% when 'avatars' %}
      <style>
        .faq-pro-avatars-{{ block.id }} {
          display: flex;
          align-items: center;
          margin-top: {{ block.settings.avatars_mt_mobile }}px;
        }

        .faq-pro-avatar-{{ block.id }} {
          display: block;
          flex: 0 0 auto;
          width: {{ block.settings.avatars_size_mobile }}px;
          height: {{ block.settings.avatars_size_mobile }}px;
          max-width: none;
          margin: 0;
          padding: 0;
          border: {{ block.settings.avatars_border_thickness }}px solid {{ block.settings.avatars_border_color }};
          border-radius: 50%;
          box-sizing: border-box;
          object-fit: cover;
          background-color: #E5E5E5;
        }

        .faq-pro-avatar-{{ block.id }} + .faq-pro-avatar-{{ block.id }} {
          margin-inline-start: -{{ block.settings.avatars_overlap }}px;
        }

        @media(min-width: 1024px) {
          .faq-pro-avatars-{{ block.id }} {
            margin-top: {{ block.settings.avatars_mt }}px;
          }

          .faq-pro-avatar-{{ block.id }} {
            width: {{ block.settings.avatars_size }}px;
            height: {{ block.settings.avatars_size }}px;
          }
        }
      </style>

    {% when 'button' %}
      <style>
        .faq-pro-button-{{ block.id }} {
          position: relative;
          text-decoration: none;
          margin-top: {{ block.settings.button_mt_mobile }}px !important;
          width: {% if block.settings.button_full_width_mobile %}100%{% else %}fit-content{% endif %};
        }

        .faq-pro-button-inner-{{ block.id }} {
          display: flex;
          align-items: center;
          justify-content: center;
          max-width: {% if block.settings.button_full_width_mobile %}100%{% else %}fit-content{% endif %};
          gap: 10px;
          width: 100%;
          margin: 0;
          font-size: {{ block.settings.button_size_mobile }}px;
          font-weight: 700;
          color: {{ block.settings.button_color }};
          line-height: {{ block.settings.button_height }}%;
          text-align: center;
          text-transform: unset;
          text-decoration: none;
          padding: {{ block.settings.button_padding_vertical_mobile }}px {{ block.settings.button_padding_horizontal_mobile }}px;
          border-radius: {{ block.settings.button_radius }}px;
          transition: all 0.25s ease 0s;
          background-color: transparent;
          border: 0px;
          cursor: pointer;
          {% if block.settings.button_custom_styling and block.settings.button_style != "link" %}
            position: relative;
            overflow: hidden;
          {% endif %}
        }

        {% if block.settings.button_custom_styling and block.settings.button_style != "link" %}
          .faq-pro-button-inner-{{ block.id }} {
            background: linear-gradient(180deg, {{ block.settings.button_bg_color | color_lighten: 4 }}, {{ block.settings.button_bg_color | color_darken: 10 }});
            box-shadow: 0 14px 30px {{ block.settings.button_shadow_color | color_modify: 'alpha', 0.28 }}, 0 5px 12px {{ block.settings.button_shadow_color | color_modify: 'alpha', 0.2 }}, inset 0 1px 0 #ffffff26;
            backdrop-filter: saturate(1.05);
          }

          .faq-pro-button-inner-{{ block.id }}::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            transition: left 0.6s ease;
          }

          .faq-pro-button-inner-{{ block.id }}:hover::before {
            left: 100%;
          }

          .faq-pro-button-inner-{{ block.id }}:hover {
            color: {{ block.settings.button_hover_color }};
            background: linear-gradient(180deg, {{ block.settings.button_bg_hover_color | color_lighten: 4 }}, {{ block.settings.button_bg_hover_color | color_darken: 10 }});
            transform: translateY(-2px);
            box-shadow: 0 18px 36px {{ block.settings.button_shadow_color | color_modify: 'alpha', 0.34 }}, 0 7px 16px {{ block.settings.button_shadow_color | color_modify: 'alpha', 0.24 }}, inset 0 1px 0 #ffffff33;
          }

          .faq-pro-button-inner-{{ block.id }}:active {
            transform: translateY(1px);
            filter: brightness(1.00208);
            box-shadow: 0 4px 8px {{ block.settings.button_shadow_color | color_modify: 'alpha', 0.3 }}, 0 2px 4px {{ block.settings.button_shadow_color | color_modify: 'alpha', 0.2 }}, inset 0 1px 0 #ffffff0d, inset 0 -1px 0 {{ block.settings.button_shadow_color | color_modify: 'alpha', 0.2 }};
          }
        {% else %}
          .faq-pro-button-inner-{{ block.id }}:hover {
            color: {{ block.settings.button_hover_color }};
          }
        {% endif %}

        .faq-pro-button-inner-{{ block.id }} svg {
          width: 14px !important;
          height: 14px !important;
          background: transparent;
          min-height: auto !important;
          flex: none;
        }

        @media(min-width: 1024px) {
          .faq-pro-button-{{ block.id }} {
            margin-top: {{ block.settings.button_mt }}px !important;
            width: fit-content;
          }

          .faq-pro-button-inner-{{ block.id }} {
            display: flex !important;
            max-width: fit-content;
            padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
            font-size: {{ block.settings.button_size }}px;
          }
        }
      </style>

      {% if block.settings.button_custom %}
        <style>
          {{ block.settings.button_font | font_face: font_display: 'swap' }}

          .faq-pro-button-inner-{{ block.id }} {
            font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
            font-weight: {{ block.settings.button_font.weight }};
            font-style: {{ block.settings.button_font.style }};
          }
        </style>
      {% endif %}

      {% if block.settings.button_style == "non_outline" or block.settings.button_style == "non_outline_arrow" %}
        <style>
          .faq-pro-button-inner-{{ block.id }} {
            background-color: {{ block.settings.button_bg_color }};
          }

          .faq-pro-button-inner-{{ block.id }}:hover {
            background-color: {{ block.settings.button_bg_hover_color }};
          }
        </style>
      {% elsif block.settings.button_style == "outline" or block.settings.button_style == "outline_arrow" %}
        <style>
          .faq-pro-button-inner-{{ block.id }} {
            background-color: {{ block.settings.button_bg_color }};
            border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_border_color }};
          }

          .faq-pro-button-inner-{{ block.id }}:hover {
            background-color: {{ block.settings.button_bg_hover_color }};
            border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_border_hover_color }};
          }
        </style>
      {% elsif block.settings.button_style == "link" %}
        <style>
          .faq-pro-button-inner-{{ block.id }} {
            padding: 0px !important;
          }
        </style>
      {% endif %}

  {% endcase %}
{% endfor %}

<div class="section-{{ section.id }} faq-pro-{{ section.id }}" {% if background_style == 'solid' %}style="background-color:{{ background_color }};"{% else %}style="background-image: {{ background_gradient }};"{% endif %}>
  <div class="section-{{ section.id }}-settings">
    <div class="faq-pro-body-{{ section.id }}">

      <div class="faq-pro-content-{{ section.id }}">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'badge' %}
              {% if block.settings.badge_text != blank %}
                <p class="faq-pro-badge-{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.badge_text }}</p>
              {% endif %}
            {% when 'heading' %}
              {% if block.settings.heading != blank %}
                <div class="faq-pro-heading-{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</div>
              {% endif %}
            {% when 'text' %}
              {% if block.settings.text != blank %}
                <div class="faq-pro-text-{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
              {% endif %}
            {% when 'avatars' %}
              {%- liquid
                assign avatar_class = 'faq-pro-avatar-' | append: block.id
                assign avatar_sizes = '(min-width: 1024px) ' | append: block.settings.avatars_size | append: 'px, ' | append: block.settings.avatars_size_mobile | append: 'px'
              -%}
              {% if block.settings.avatar_1 != blank or block.settings.avatar_2 != blank or block.settings.avatar_3 != blank %}
                <div class="faq-pro-avatars-{{ block.id }}" {{ block.shopify_attributes }}>
                  {% for i in (1..3) %}
                    {%- assign avatar_key = 'avatar_' | append: i -%}
                    {%- assign avatar = block.settings[avatar_key] -%}
                    {% if avatar != blank %}
                      {{ avatar | image_url: width: 160 | image_tag: widths: '80, 120, 160', sizes: avatar_sizes, loading: 'lazy', class: avatar_class }}
                    {% endif %}
                  {% endfor %}
                </div>
              {% elsif request.design_mode %}
                <div class="faq-pro-avatars-{{ block.id }}" {{ block.shopify_attributes }}>
                  {% for i in (1..3) %}
                    <span class="{{ avatar_class }}"></span>
                  {% endfor %}
                </div>
              {% endif %}
            {% when 'button' %}
              {% if block.settings.button != blank %}
                <{% if block.settings.url != blank %}a href="{{ block.settings.url }}"{% if block.settings.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}{% else %}div{% endif %} class="faq-pro-button-{{ block.id }}" {{ block.shopify_attributes }}>
                  <p class="faq-pro-button-inner-{{ block.id }}">
                    {{ block.settings.button }}
                    {% if block.settings.button_style == "non_outline_arrow" or block.settings.button_style == "outline_arrow" %}
                      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                        <path d="M3.75 9H14.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M9 3.75L14.25 9L9 14.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {% endif %}
                  </p>
                </{% if block.settings.url != blank %}a{% else %}div{% endif %}>
              {% endif %}
          {% endcase %}
        {% endfor %}
      </div>

      <div class="faq-pro-tabs-col-{{ section.id }}">
        {% assign tab_blocks = section.blocks | where: 'type', 'tab' %}
        {% if tab_blocks.size > 0 %}
          <div class="faq-pro-toggles-{{ section.id }}" role="tablist">
            {% for block in tab_blocks %}
              <button type="button" role="tab" class="faq-pro-toggle-{{ section.id }}{% if forloop.first %} active{% endif %}" id="{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="faq-pro-panel-{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.tab }}</button>
            {% endfor %}
          </div>
        {% endif %}

        <div class="faq-pro-tabs-{{ section.id }}">
          {% assign inside_item = false %}
          {% assign tab_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'tab' %}
              {% if inside_item %}
                </div>
              {% endif %}
              <div class="faq-pro-tab-{{ section.id }}{% if tab_index == 0 %} active{% endif %}" id="faq-pro-panel-{{ block.id }}" role="tabpanel" aria-labelledby="{{ block.id }}" data-id="{{ block.id }}">
                {% assign inside_item = true %}
                {% assign tab_index = tab_index | plus: 1 %}
            {% elsif block.type == 'faq_item' %}
              {% unless inside_item %}
                <div class="faq-pro-tab-{{ section.id }} active">
                {% assign inside_item = true %}
              {% endunless %}
              <div class="faq-pro-item-{{ section.id }}" {{ block.shopify_attributes }}>
                <button type="button" class="faq-pro-item-toggle-{{ section.id }}" aria-expanded="false" aria-controls="faq-pro-answer-{{ block.id }}">
                  <span class="faq-pro-question-{{ section.id }}">{{ block.settings.question }}</span>
                  <span class="faq-pro-icon-{{ section.id }}" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M8.00045 8.78094L11.3003 5.48112L12.2431 6.42393L8.00045 10.6666L3.75781 6.42393L4.70063 5.48112L8.00045 8.78094Z" fill="currentColor"></path>
                    </svg>
                  </span>
                </button>
                {% capture answer_image %}
                  {% if block.settings.answer_image != blank %}
                    {% assign answer_image_class = 'faq-pro-answer-image-' | append: section.id %}
                    {{ block.settings.answer_image | image_url: width: 1600 | image_tag: widths: '375, 550, 750, 900, 1100, 1400, 1600', sizes: '(min-width: 1024px) 800px, 100vw', loading: 'lazy', class: answer_image_class }}
                  {% endif %}
                {% endcapture %}
                {% capture answer_content %}
                  {% if answer_image_position == 'above' %}{{ answer_image }}{% endif %}
                  {{ block.settings.answer }}
                  {% if answer_image_position != 'above' %}{{ answer_image }}{% endif %}
                {% endcapture %}
                <div class="faq-pro-answer-{{ section.id }}" id="faq-pro-answer-{{ block.id }}" style="display: none; height: 0px; padding-top: 0px;">
                  {{ answer_content }}
                </div>
                <div class="faq-pro-height-cal-{{ section.id }}" aria-hidden="true">
                  {{ answer_content }}
                </div>
              </div>
            {% endif %}
          {% endfor %}
          {% if inside_item %}
            </div>
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  function initFaqPro{{ section.id | replace: '-', '' }}() {
    const section = document.querySelector('.faq-pro-{{ section.id }}');
    if (!section || section.dataset.faqProInit) return;
    section.dataset.faqProInit = 'true';

    const toggles = section.querySelectorAll('.faq-pro-toggle-{{ section.id }}');
    const tabs = section.querySelectorAll('.faq-pro-tab-{{ section.id }}[data-id]');
    const items = section.querySelectorAll('.faq-pro-item-{{ section.id }}');
    const buttons = section.querySelectorAll('.faq-pro-item-toggle-{{ section.id }}');
    const answers = section.querySelectorAll('.faq-pro-answer-{{ section.id }}');
    const answersHeightCalElements = section.querySelectorAll('.faq-pro-height-cal-{{ section.id }}');
    const answerPaddingTop = {{ answer_padding_top }};
    const closeTimers = [];

    let activeIndex = -1;

    function setHeight(index) {
      const height = answersHeightCalElements[index].offsetHeight;
      if (height > 0) {
        answers[index].style.height = `${height}px`;
      }
    }

    function openAnswer(index) {
      clearTimeout(closeTimers[index]);
      answers[index].style.display = 'block';
      setTimeout(() => {
        answers[index].style.paddingTop = `${answerPaddingTop}px`;
        setHeight(index);
      });
      items[index].classList.add('active');
      buttons[index].setAttribute('aria-expanded', 'true');
    }

    function closeAnswer(index) {
      clearTimeout(closeTimers[index]);
      answers[index].style.paddingTop = 0;
      answers[index].style.height = 0;
      closeTimers[index] = setTimeout(() => {
        answers[index].style.display = 'none';
      }, 300);
      items[index].classList.remove('active');
      buttons[index].setAttribute('aria-expanded', 'false');
    }

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => {
        if (activeIndex !== -1 && activeIndex !== index) {
          closeAnswer(activeIndex);
        }
        if (activeIndex === index) {
          closeAnswer(index);
          activeIndex = -1;
        } else {
          openAnswer(index);
          activeIndex = index;
        }
      });
    });

    toggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        toggles.forEach(other => {
          const selected = other === toggle;
          other.classList.toggle('active', selected);
          other.setAttribute('aria-selected', selected ? 'true' : 'false');
        });
        tabs.forEach(tab => {
          tab.classList.toggle('active', tab.getAttribute('data-id') === toggle.id);
        });
        if (activeIndex !== -1) {
          setHeight(activeIndex);
        }
      });
    });

    answersHeightCalElements.forEach(element => {
      element.querySelectorAll('img').forEach(img => {
        img.addEventListener('load', () => {
          if (activeIndex !== -1) {
            setHeight(activeIndex);
          }
        });
      });
    });

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        if (activeIndex !== -1) {
          setHeight(activeIndex);
        }
      }, 250);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFaqPro{{ section.id | replace: '-', '' }});
  } else {
    initFaqPro{{ section.id | replace: '-', '' }}();
  }

  if (window.Shopify && Shopify.designMode) {
    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === '{{ section.id }}') initFaqPro{{ section.id | replace: '-', '' }}();
    });
  }
</script>{%- elsif request.design_mode -%}
