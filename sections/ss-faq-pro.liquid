            "type": "faq_item",
            "settings": {
              "question": "How do I place an order?",
              "answer": "<p>Add the items you love to your cart and head to checkout. You'll receive a confirmation email as soon as your order is placed.</p>"
            }
          },
          {
            "type": "faq_item",
            "settings": {
              "question": "Which payment methods do you accept?",
              "answer": "<p>We accept all major credit and debit cards, as well as popular express checkout options. Every payment is processed securely.</p>"
            }
          },
          {
            "type": "faq_item",
            "settings": {
              "question": "Can I change or cancel my order?",
              "answer": "<p>Yes, as long as it hasn't shipped yet. Get in touch as soon as possible and we'll update or cancel it for you.</p>"
            }
          },
          {
            "type": "faq_item",
            "settings": {
              "question": "Do you offer discounts?",
              "answer": "<p>Sign up for our newsletter to be the first to hear about new arrivals, exclusive offers and seasonal sales.</p>"
            }
          },
          {
            "type": "tab",
            "settings": { "tab": "Shipping & delivery" }
          },
          {
            "type": "faq_item",
            "settings": {
              "question": "How long does shipping take?",
              "answer": "<p>Orders are processed within 1–2 business days. Delivery times depend on your location and the shipping method you choose at checkout.</p>"
            }
          },
          {
            "type": "faq_item",
            "settings": {
              "question": "How much does shipping cost?",
              "answer": "<p>Shipping costs are calculated at checkout based on your location and the size of your order.</p>"
            }
          },
          {
            "type": "faq_item",
            "settings": {
              "question": "How can I track my order?",
              "answer": "<p>As soon as your order ships, you'll receive an email with a tracking link so you can follow it all the way to your door.</p>"
            }
          },
          {
            "type": "faq_item",
            "settings": {
              "question": "Do you ship internationally?",
              "answer": "<p>Yes, we ship to most countries. Available destinations and rates are shown at checkout. Duties and taxes may apply depending on your country.</p>"
            }
          },
          {
            "type": "tab",
            "settings": { "tab": "Returns & exchanges" }
          },
          {
            "type": "faq_item",
            "settings": {
              "question": "What is your return policy?",
              "answer": "<p>If you're not completely happy with your purchase, you can return it within 30 days of delivery. Items should be unused and in their original packaging.</p>"
            }
          },
          {
            "type": "faq_item",
            "settings": {
              "question": "How do I start a return?",
              "answer": "<p>Contact our team with your order number and we'll send you everything you need to send your items back.</p>"
            }
          },
          {
            "type": "faq_item",
            "settings": {
              "question": "Can I exchange an item?",
              "answer": "<p>Of course. If you need a different size or color, let us know and we'll help you swap it for the right one.</p>"
            }
          },
          {
            "type": "faq_item",
            "settings": {
              "question": "When will I receive my refund?",
              "answer": "<p>Once we receive and check your return, we'll refund your original payment method. Refunds usually appear within 5–10 business days.</p>"
            }
          }
