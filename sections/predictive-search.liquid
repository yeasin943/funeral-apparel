{% comment %}
  Section contract.
  Renders the search palette results for a typed query, or the recently viewed products when
  predictive-search.js requests products by ID. Fetched through the Section Rendering API and
  morphed into the search modal; never placed on a page.
  @example
  <!-- /search/suggest?q=her&section_id=predictive-search -->
{% endcomment %}

{% render 'predictive-search-styles' %}

{%- if predictive_search.performed or search.performed -%}
  <div
    id="predictive-search-results"
    class="predictive-search-dropdown"
    role="listbox"
    aria-label="{{ 'content.search_results_label' | t }}"
    data-transition-container
  >
    <div
      class="predictive-search-results__inner"
      data-search-results
      data-scope="all"
    >
      {% if predictive_search.performed %}
        {% liquid
          assign products = predictive_search.resources.products
          assign collections = predictive_search.resources.collections
          assign pages = predictive_search.resources.pages
          assign articles = predictive_search.resources.articles
          assign queries = predictive_search.resources.queries
          assign search_results_count = products.size | plus: collections.size | plus: pages.size | plus: articles.size
        %}
      {% else %}
        {% assign search_results_count = search.results_count %}
      {% endif %}
      <div
        class="visually-hidden"
        role="status"
      >
        {%- if predictive_search.performed and search_results_count > 0 -%}
          {{ 'accessibility.search_results_count' | t: count: search_results_count, query: predictive_search.terms }}
        {%- elsif predictive_search.performed and queries.size > 0 -%}
          {{- 'accessibility.search_suggestions_available' | t: query: predictive_search.terms -}}
        {%- elsif predictive_search.performed -%}
          {{ 'accessibility.search_results_no_results' | t: query: predictive_search.terms }}
        {%- endif -%}
      </div>

      {% if predictive_search.performed %}
        {%- capture search_url -%}
          {{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&options%5Bprefix%5D=last
        {%- endcapture -%}

        {%- if search_results_count > 0 -%}
          <div class="search-palette__toolbar">
            <div
              class="search-palette__scopes"
              role="group"
              aria-label="{{ 'accessibility.search_results_filter' | t }}"
            >
              {% render 'search-palette-scope',
                scope: 'all',
                label: 'content.search_results_all',
                count: search_results_count
              %}
              {% render 'search-palette-scope',
                scope: 'products',
                label: 'content.search_results_resource_products',
                count: products.size
              %}
              {% render 'search-palette-scope',
                scope: 'collections',
                label: 'content.search_results_resource_collections',
                count: collections.size
              %}
              {% render 'search-palette-scope',
                scope: 'pages',
                label: 'content.search_results_resource_pages',
                count: pages.size
              %}
              {% render 'search-palette-scope',
                scope: 'articles',
                label: 'content.search_results_resource_articles',
                count: articles.size
              %}
            </div>
            <a
              href="{{ search_url }}"
              class="search-palette__text-link"
            >
              {{- 'content.search_results_view_all' | t -}}
            </a>
          </div>
        {%- endif -%}

        <div class="search-palette__results">
          {% if queries.size > 0 %}
            <div class="search-palette__group search-palette__group--queries">
              <div class="search-palette__label-row">
                <h4 class="search-palette__label">{{ 'content.search_results_suggestions' | t }}</h4>
              </div>
              <ul class="predictive-search-results__wrapper-queries search-palette__queries list-unstyled">
                {%- for resource in queries -%}
                  <li
                    class="predictive-search-results__card--query"
                    ref="resultsItems[]"
                    on:keydown="/onSearchKeyDown"
                  >
                    <a
                      class="search-palette__query"
                      href="{{ resource.url }}"
                      aria-label="{{ resource.text | escape }}"
                    >
                      {{- resource.styled_text -}}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {% endif %}

          {%- if search_results_count > 0 -%}
            {% if products.size > 0 %}
              {%- assign products_shown = products.size | at_most: 3 -%}
              <div
                class="search-palette__group"
                data-scope-group="products"
              >
                <div class="search-palette__label-row">
                  <h4 class="search-palette__label">{{ 'content.search_results_resource_products' | t }}</h4>
                  <span class="search-palette__label search-palette__count">
                    {{- 'content.search_results_shown_count' | t: shown: products_shown, total: products.size -}}
                  </span>
                </div>
                <ul class="search-palette__products predictive-search-results__wrapper-products list-unstyled">
                  {%- for product in products -%}
                    {% render 'search-palette-product', product: product, ref: 'resultsItems[]' %}
                  {%- endfor -%}
                </ul>
              </div>
            {% endif %}

            {% if collections.size > 0 %}
              <div
                class="search-palette__group"
                data-scope-group="collections"
              >
                <div class="search-palette__label-row">
                  <h4 class="search-palette__label">{{ 'content.search_results_resource_collections' | t }}</h4>
                </div>
                <ul class="search-palette__collections predictive-search-results__list list-unstyled">
                  {%- for collection in collections -%}
                    {% render 'search-palette-resource', resource: collection, resource_type: 'collection' %}
                  {%- endfor -%}
                </ul>
              </div>
            {% endif %}

            {% if pages.size > 0 %}
              <div
                class="search-palette__group"
                data-scope-group="pages"
              >
                <div class="search-palette__label-row">
                  <h4 class="search-palette__label">{{ 'content.search_results_resource_pages' | t }}</h4>
                </div>
                <ul class="search-palette__rows predictive-search-results__list list-unstyled">
                  {%- for page in pages -%}
                    {% render 'search-palette-resource', resource: page, resource_type: 'page' %}
                  {%- endfor -%}
                </ul>
              </div>
            {% endif %}

            {% if articles.size > 0 %}
              <div
                class="search-palette__group"
                data-scope-group="articles"
              >
                <div class="search-palette__label-row">
                  <h4 class="search-palette__label">{{ 'content.search_results_resource_articles' | t }}</h4>
                </div>
                <ul class="search-palette__rows predictive-search-results__list list-unstyled">
                  {%- for article in articles -%}
                    {% render 'search-palette-resource', resource: article, resource_type: 'article' %}
                  {%- endfor -%}
                </ul>
              </div>
            {% endif %}
          {%- elsif queries.size == 0 -%}
            <p class="predictive-search-results__no-results">
              {{ 'content.search_results_no_results' | t: terms: predictive_search.terms }}
            </p>
          {%- endif -%}
        </div>

        {%- if search_results_count > 0 -%}
          <a
            href="{{ search_url }}"
            class="search-palette__view-all-bar"
          >
            <span>{{ 'content.search_results_view_all_count' | t: count: search_results_count }}</span>
            <span class="search-palette__chevron">
              {{- 'icon-chevron-right-line.svg' | inline_asset_content -}}
            </span>
          </a>
        {%- endif -%}
      {% else %}
        {%- liquid
          assign title = 'content.recently_viewed_products' | t
          assign products = search.results
          comment
            Searching for recently viewed products by id doesn't preserve the order of the products.
            To work around this, we get the product ids into an array then use that to reorder them.
          endcomment
          if search.terms contains 'id:'
            assign new_products_ids = search.terms | replace: 'id:', '' | split: ' OR '
          endif
          render 'predictive-search-products-list', title: title, products: products, order_ids: new_products_ids, limit: 4
        -%}
      {% endif %}

      {% if predictive_search.performed and search_results_count == 1 %}
        {% liquid
          assign single_result_url = products.first.url | default: collections.first.url | default: pages.first.url | default: articles.first.url
        %}
        <div data-single-result-url="{{ single_result_url }}"></div>
      {% endif %}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:names.predictive_search",
  "settings": [],
  "blocks": [
    {
      "type": "@theme"
    }
  ]
}
{% endschema %}
