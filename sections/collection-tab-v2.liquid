{% stylesheet %}

  .collection-tabs [hidden] {
    display: none !important;
  }

  .collection-tabs {
    --bleed: 0px;
  }

  .collection-tabs--title-weight .collection-tabs__item p[role='heading'] {
    font-weight: var(--title-weight);
  }

  .collection-tabs--compare-color .collection-tabs__item :is(s, del, .compare-at-price) {
    color: var(--compare-color);
  }


  .collection-tabs.section--page-width {
    --bleed: var(--page-margin, 16px);
  }

  .collection-tabs [hidden] {
    display: none;
  }

  .collection-tabs__heading {
    margin: 0;
    text-align: var(--alignment);
  }

  .collection-tabs__controls {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
  }

  .shopify-section:has(> .collection-tabs--sticky),
  .collection-tabs--sticky {
    overflow: visible;
  }

  .collection-tabs--sticky .collection-tabs__controls {
    position: sticky;
    top: var(--sticky-offset, 0px);
    z-index: 10;
    margin-inline: calc(var(--bleed) * -1);
    padding: 12px var(--bleed);
    background: var(--color-background);
  }

  .collection-tabs__tabs {
    --fade-start: 0px;
    --fade-end: 0px;
    display: flex;
    position: sticky;
    flex: 1;
    gap: 8px;
    min-width: 0;
    justify-content: safe var(--alignment);
    overflow-x: auto;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, transparent, #000 var(--fade-start), #000 calc(100% - var(--fade-end)), transparent);
    
  }

  .collection-tabs__tabs.fade-start {
    --fade-start: 28px;
  }

  .collection-tabs__tabs.fade-end {
    --fade-end: 28px;
  }

  .collection-tabs__tab {
    flex: none;
    padding: 12px 16px;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 15%, transparent);
    /* border-radius: var(--tab-radius); */
    background: transparent;
    color: color-mix(in srgb, var(--color-foreground) 65%, transparent);
    font: inherit;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.25s, border-color 0.25s, color 0.25s;
    @media(max-width: 768px){
      padding: 10px 16px;
    }
  }

  .collection-tabs__tab[aria-selected='true'] {
    border-color: var(--color-foreground);
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .collection-tabs__arrows {
    display: flex;
    gap: 8px;
  }

  .collection-tabs__arrow {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 15%, transparent);
    border-radius: 50%;
    background: var(--color-background);
    color: var(--color-foreground);
    cursor: pointer;
    transition: background-color 0.3s, color 0.3s;
  }

  .collection-tabs__arrow:not(:disabled):hover {
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .collection-tabs__arrow:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .collection-tabs__arrow svg {
    width: 14px;
    height: 14px;
  }

  .collection-tabs__row {
    display: flex;
    gap: var(--gap);
    margin: 28px calc(var(--bleed) * -1) 0;
    padding-inline: var(--bleed);
    scroll-padding-inline: var(--bleed);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .collection-tabs__tabs::-webkit-scrollbar,
  .collection-tabs__row::-webkit-scrollbar {
    display: none;
  }

  .collection-tabs__item {
    flex: 0 0 calc((100% - var(--gap) * (var(--columns-mobile) - 1)) / var(--columns-mobile));
    min-width: 0;
    scroll-snap-align: start;
  }

  @media screen and (max-width: 749px) {
    .collection-tabs--grid:not(.collection-tabs--mobile-carousel) .collection-tabs__row {
      display: grid;
      grid-template-columns: repeat(var(--grid-columns-mobile), minmax(0, 1fr));
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
      scroll-snap-type: none;
    }
  }

  @media screen and (min-width: 750px) {
    .collection-tabs {
      --bleed: 0px;
    }

    .collection-tabs__controls {
      gap: 20px;
      margin-top: 24px;
    }

    .collection-tabs__tab {
      padding: 14px 22px;
    }

    .collection-tabs__arrow {
      width: 46px;
      height: 46px;
    }

    .collection-tabs--center .collection-tabs__controls {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }

    .collection-tabs--center .collection-tabs__tabs {
      grid-column: 2;
    }

    .collection-tabs--center .collection-tabs__arrows {
      grid-column: 3;
      justify-self: end;
    }

    .collection-tabs__row {
      margin-top: 40px;
    }

    .collection-tabs__item {
      flex-basis: calc((100% - var(--gap) * (var(--columns) - 1)) / var(--columns));
    }

    .collection-tabs--grid .collection-tabs__row {
      display: grid;
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
      scroll-snap-type: none;
    }
  }
{% endstylesheet %}

{% liquid
  assign collections = section.settings.collections
  assign limit = section.settings.products_limit
  assign title_weight = section.settings.title_weight
  assign compare_color = section.settings.compare_color
  assign is_grid = false
  if section.settings.layout == 'grid'
    assign is_grid = true
  endif
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<collection-tabs
  class="collection-tabs collection-tabs--{{ section.settings.alignment }}{% if is_grid %} collection-tabs--grid{% if section.settings.carousel_on_mobile %} collection-tabs--mobile-carousel{% endif %}{% endif %}{% if section.settings.sticky_tabs %} collection-tabs--sticky{% endif %}{% if title_weight != 'default' %} collection-tabs--title-weight{% endif %}{% if compare_color != blank %} collection-tabs--compare-color{% endif %} section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --alignment: {{ section.settings.alignment }};
    --columns: {{ section.settings.columns }};
    --columns-mobile: {{ section.settings.columns_mobile }};
    --grid-columns-mobile: {{ section.settings.grid_columns_mobile }};
    --gap: {{ section.settings.gap }}px;
    --tab-radius: {{ section.settings.tab_radius }}px;
    {% if section.settings.sticky_tabs %}--sticky-offset: {{ section.settings.sticky_offset }}px;{% endif %}
    {% if title_weight != 'default' %}--title-weight: {{ title_weight }};{% endif %}
    {% if compare_color != blank %}--compare-color: {{ compare_color }};{% endif %}
    {% render 'spacing-style', settings: section.settings %}
  "
>

  {% if section.settings.heading != blank %}
    <h2 class="collection-tabs__heading ">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="collection-tabs__controls">
    <div class="collection-tabs__tabs" role="tablist">
      {% for tab_collection in collections %}
        <button
          type="button"
          class="collection-tabs__tab"
          id="CollectionTab-{{ section.id }}-{{ forloop.index }}"
          role="tab"
          aria-controls="CollectionPanel-{{ section.id }}-{{ forloop.index }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          data-tab="{{ forloop.index }}"
        >
          {{ tab_collection.title }}
        </button>
      {% else %}
        <button type="button" class="collection-tabs__tab" role="tab" aria-selected="true">Collection</button>
      {% endfor %}
    </div>

    {% if section.settings.show_arrows %}
      <div class="collection-tabs__arrows" data-arrows>
        <button type="button" class="collection-tabs__arrow" data-prev aria-label="Previous">
          <svg viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M11.25 13.5 6.75 9l4.5-4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button type="button" class="collection-tabs__arrow" data-next aria-label="Next">
          <svg viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="m6.75 4.5 4.5 4.5-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    {% endif %}
  </div>

  {% for tab_collection in collections %}
    <div
      class="collection-tabs__row"
      id="CollectionPanel-{{ section.id }}-{{ forloop.index }}"
      role="tabpanel"
      aria-labelledby="CollectionTab-{{ section.id }}-{{ forloop.index }}"
      data-panel="{{ forloop.index }}"
      {% unless forloop.first %}hidden{% endunless %}
    >
      {% for product in tab_collection.products limit: limit %}
        <div class="collection-tabs__item">
          {% content_for 'block',
            type: '_product-card',
            id: 'static-product-card',
            closest.product: product,
            product_view_context: 'collection'
          %}
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="collection-tabs__row" role="tabpanel">
      {% for i in (1..4) %}
        <div class="collection-tabs__item">
          {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
        </div>
      {% endfor %}
    </div>
  {% endfor %}
</collection-tabs>

{% javascript %}
  if (!customElements.get('collection-tabs')) {
    customElements.define(
      'collection-tabs',
      class extends HTMLElement {
        connectedCallback() {
          this.tabs = this.querySelectorAll('[role="tab"]');
          this.panels = this.querySelectorAll('[role="tabpanel"]');
          this.strip = this.querySelector('[role="tablist"]');
          this.arrows = this.querySelector('[data-arrows]');
          this.update = this.update.bind(this);

          this.strip.addEventListener('click', (event) => {
            const tab = event.target.closest('[data-tab]');
            if (tab) this.select(tab.dataset.tab);
          });

          this.arrows?.addEventListener('click', (event) => {
            const arrow = event.target.closest('button');
            if (arrow) this.slide(arrow.hasAttribute('data-next') ? 1 : -1);
          });

          this.addEventListener('scroll', this.update, { capture: true, passive: true });

          this.observer = new ResizeObserver(this.update);
          this.observer.observe(this);
        }

        disconnectedCallback() {
          this.observer.disconnect();
        }

        get activePanel() {
          return this.querySelector('[role="tabpanel"]:not([hidden])');
        }

        select(id) {
          this.tabs.forEach((tab) => {
            const active = tab.dataset.tab === id;
            tab.setAttribute('aria-selected', active);
            if (active) tab.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
          });

          this.panels.forEach((panel) => {
            panel.hidden = panel.dataset.panel !== id;
          });

          this.update();
        }

        slide(direction) {
          const panel = this.activePanel;
          const card = panel?.firstElementChild;
          if (card) panel.scrollBy({ left: direction * card.offsetWidth, behavior: 'smooth' });
        }

        edges(element) {
          const max = element.scrollWidth - element.clientWidth;
          return {
            scrollable: max > 1,
            start: element.scrollLeft > 1,
            end: element.scrollLeft < max - 1
          };
        }

        update() {
          const strip = this.edges(this.strip);
          this.strip.classList.toggle('fade-start', strip.start);
          this.strip.classList.toggle('fade-end', strip.end);

          const panel = this.activePanel;
          if (!this.arrows || !panel) return;

          const row = this.edges(panel);
          this.arrows.hidden = !row.scrollable;
          this.arrows.querySelector('[data-prev]').disabled = !row.start;
          this.arrows.querySelector('[data-next]').disabled = !row.end;
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Collection tabs V2",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "info": "Each collection becomes a tab.",
      "limit": 10
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products per tab",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "carousel", "label": "Carousel" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "carousel"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "Carousel on mobile",
      "default": false,
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "default": 1.6,
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "select",
      "id": "grid_columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.layout == 'grid' and section.settings.carousel_on_mobile == false }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "default"
    },
    {
      "type": "color",
      "id": "compare_color",
      "label": "Compare-at price color",
      "info": "Leave empty to use the price color from the product card."
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "header",
      "content": "Tabs"
    },
    {
      "type": "range",
      "id": "tab_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "sticky_tabs",
      "label": "Sticky tabs",
      "default": false
    },
    {
      "type": "range",
      "id": "sticky_offset",
      "label": "Sticky offset",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "If your header is sticky, set this to its height.",
      "visible_if": "{{ section.settings.sticky_tabs }}"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Collection tabs V2",
      "category": "Products",
      "blocks": {
        "static-product-card": {
          "type": "_product-card",
          "name": "t:names.product_card",
          "static": true,
          "settings": {
            "product_card_gap": 4,
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "product-card-gallery": {
              "type": "_product-card-gallery",
              "name": "t:names.product_card_media",
              "settings": {
                "image_ratio": "adapt",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "product_title": {
              "type": "product-title",
              "name": "t:names.product_title",
              "settings": {
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "paragraph",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 4,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "price": {
              "type": "price",
              "name": "t:names.product_price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "h6",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            }
          },
          "block_order": ["product-card-gallery", "product_title", "price"]
        }
      }
    }
  ]
}
{% endschema %}