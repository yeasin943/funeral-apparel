    "ss-testimonial-8-5": {
      "type": "ss-testimonial-8",
      "blocks": {
        "ss-5-testimonials-1": {
          "type": "testimonials",
          "settings": {
            "stars_count": 5.0,
            "heading": "True to size, finally",
            "text": "I used to size up in every street tee and still look boxy in the wrong way. Had the Lethal Dose shirt three months. Wear it to shows and to work under a jacket. Cropped hem hits where it should. Print cracked a little at the collar after hot washes, which I kind of like.",
            "author_date": "Shane S."
          }
        },
        "ss-5-testimonials-2": {
          "type": "testimonials",
          "settings": {
            "stars_count": 5.0,
            "heading": "Flares that actually move",
            "text": "Came from skinny black jeans that never sat right at the shoe. These washed flares have been in rotation since winter. Drawstrings are long enough to knot how I want. Gothic script on the leg reads in photos without looking costume. Pockets are deep. Hem drags a bit if I wear chunky boots.",
            "author_date": "Kirsten M."
          }
        },
        "ss-5-testimonials-3": {
          "type": "testimonials",
          "settings": {
            "stars_count": 4.0,
            "heading": "Graphics that hold up",
            "text": "Bought the Live tee after a year of mall graphics that peeled in two washes. Organic cotton feels light but not cheap. True to size on me. Worn it out four weekends in a row. Black still looks black. Wish the crop was a hair longer for my torso, hence four stars.",
            "author_date": "Noel J."
          }
        },
        "ss-5-testimonials-4": {
          "type": "testimonials",
          "settings": {
            "stars_count": 5.0,
            "heading": "Jacket for real nights",
            "text": "I was living in a thin denim jacket that died at 1 a.m. Ghost carpenter has been my closer for two months of late sets. Canvas feels sturdy. Slash pockets actually hold a phone. Boxy cut looks like workwear, not a costume. Zipper is a little stiff at first. Worth it.",
            "author_date": "Warren M."
          }
        },
        "ss-5-testimonials-5": {
          "type": "testimonials",
          "settings": {
            "stars_count": 5.0,
            "heading": "Distress that looks lived-in",
            "text": "Used to buy fake-destroy tanks that felt like they were cut with scissors in a warehouse. Distressed tank in pepper wash has been my summer layer. Raw arms, hanging strip at the hem, still wearable to the bodega at noon. Cotton is heavy enough. Tears look honest, not costume.",
            "author_date": "Felicia S."
          }
        }
      },
      "block_order": [
        "ss-5-testimonials-1",
        "ss-5-testimonials-2",
        "ss-5-testimonials-3",
        "ss-5-testimonials-4",
        "ss-5-testimonials-5"
      ],
