<style>
    .--breadcrumb-wrap a{
      color: var(--color-ink, #0B0B0B);
      /* Label/Mono */
      {% comment %} font-family: "Geist Mono"; {% endcomment %}
      font-size: 12px;
      font-weight: 500;
      line-height: 130%;
      letter-spacing: 0.96px;
      text-transform: uppercase;
    }
</style>

<div class="--breadcrumb-wrap">
  {% assign collection = product.collections[0] %}

  {% if collection != blank %}
    <a class="" href="{{ collection.url }}">{{- collection.title -}}</a>
  {% endif %}
  {% comment %} <a class="" href="{{ product.url }}">{{- product.title -}}</a> {% endcomment %}
</div>

{% schema %}
{
  "name": "Breadcrumb",
  "settings": [],
  "presets": [
    {
      "name": "Breadcrumb",
      "category": "Basic"
    }
  ]
}
{% endschema %}
